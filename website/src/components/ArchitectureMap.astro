import { localeFromPath, type Locale } from "../data/i18n";

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? localeFromPath(Astro.url.pathname);
const isChinese = locale === "zh-CN";
const copy = isChinese
  ? {
      caption:
        "StateKnot 架构从 Core 合约延伸到 Graph 执行、PostgreSQL 耐久化、协议 Adapter 与运维；每个节点都标明它在 pre-alpha 仓库中的实现状态。",
      legend: "实现状态图例",
      implemented: "已实现切片",
      active: "开发中",
      planned: "规划中",
      contracts: "Core 合约",
      typedDomain: "类型化领域模型",
      typedDomainDetail: "Capability、Content、Identity、Scope、Budget",
      durableFacts: "耐久事实",
      durableFactsDetail:
        "Run、Admission、Submission Key、Journal、Checkpoint、Result",
      execution: "Graph 执行",
      barrier: "Barrier 合约",
      barrierDetail: "Canonical Graph、Reducer Planning、后继 Checkpoint",
      runtime: "耐久 Agent Runtime",
      runtimeDetail:
        "Provider-native Turn、Driver、Invocation、Lifecycle Cancellation 与 Crash Takeover",
      postgres: "PostgreSQL 耐久化",
      persistence: "Fenced Persistence",
      persistenceDetail: "Lease、Attempt、Outbox、Interrupt、Timer",
      recovery: "恢复证据",
      recoveryDetail: "Pinned Graph、Quarantine、有界规划、Durable Start",
      protocols: "协议",
      mcpDetail: "2026-07-28 通用 Tool Client 与严格耐久 Remote Tool",
      a2aDetail: "REST 与 JSON-RPC Client/Server",
      operations: "运维",
      agentService: "AgentService v1",
      agentServiceDetail: "Authorization-first Submit、Read 与 Cancel",
      controlPlane: "Control Plane",
      controlPlaneDetail: "Policy、Tenant Admin、Budget、Release Routing",
      qualification: "验证体系",
      qualificationDetail: "Telemetry、Evaluation、Compatibility、Fault",
    }
  : {
      caption:
        "StateKnot architecture from core contracts through graph execution, PostgreSQL durability, protocol adapters, and operations. Each node states whether its implementation exists in the pre-alpha repository.",
      legend: "Implementation status legend",
      implemented: "Implemented slice",
      active: "In progress",
      planned: "Planned",
      contracts: "Core contracts",
      typedDomain: "Typed domain",
      typedDomainDetail: "Capabilities, content, identity, scope, budgets",
      durableFacts: "Durable facts",
      durableFactsDetail:
        "Runs, admissions, submission keys, journal, checkpoints, results",
      execution: "Graph execution",
      barrier: "Barrier contracts",
      barrierDetail:
        "Canonical graphs, reducer planning, successor checkpoints",
      runtime: "Durable Agent runtime",
      runtimeDetail:
        "Provider-native turns, Driver, invocations, lifecycle cancellation, and crash takeover",
      postgres: "PostgreSQL durability",
      persistence: "Fenced persistence",
      persistenceDetail: "Leases, attempts, outbox, interrupts, timers",
      recovery: "Recovery evidence",
      recoveryDetail:
        "Pinned graphs, quarantine, bounded planning, durable starts",
      protocols: "Protocols",
      mcpDetail:
        "2026-07-28 general Tool client and strict durable Remote Tool",
      a2aDetail: "REST and JSON-RPC client/server",
      operations: "Operations",
      agentService: "AgentService v1",
      agentServiceDetail: "Authorization-first submit, read, and cancel",
      controlPlane: "Control plane",
      controlPlaneDetail:
        "Policy, tenant administration, budgets, release routing",
      qualification: "Qualification",
      qualificationDetail: "Telemetry, evaluation, compatibility, faults",
    };
---

<figure class="architecture-figure">
  <figcaption class="sr-only">
    {copy.caption}
  </figcaption>

  <div class="map-legend" aria-label={copy.legend}>
    <span
      ><i class="legend-mark legend-mark--implemented" aria-hidden="true"></i>{
        copy.implemented
      }</span
    >
    <span
      ><i class="legend-mark legend-mark--active" aria-hidden="true"></i>{
        copy.active
      }</span
    >
    <span
      ><i class="legend-mark legend-mark--planned" aria-hidden="true"></i>{
        copy.planned
      }</span
    >
  </div>

  <div class="architecture-map">
    <section class="map-column" aria-labelledby="map-contracts">
      <h3 id="map-contracts">{copy.contracts}</h3>
      <div class="map-node map-node--implemented">
        <span class="map-node__status">{copy.implemented}</span>
        <strong>{copy.typedDomain}</strong>
        <small>{copy.typedDomainDetail}</small>
      </div>
      <div class="map-node map-node--implemented">
        <span class="map-node__status">{copy.implemented}</span>
        <strong>{copy.durableFacts}</strong>
        <small>{copy.durableFactsDetail}</small>
      </div>
    </section>

    <section class="map-column" aria-labelledby="map-execution">
      <h3 id="map-execution">{copy.execution}</h3>
      <div class="map-node map-node--implemented">
        <span class="map-node__status">{copy.implemented}</span>
        <strong>{copy.barrier}</strong>
        <small>{copy.barrierDetail}</small>
      </div>
      <div class="map-node map-node--implemented">
        <span class="map-node__status">{copy.implemented}</span>
        <strong>{copy.runtime}</strong>
        <small>{copy.runtimeDetail}</small>
      </div>
    </section>

    <section class="map-column map-column--anchor" aria-labelledby="map-store">
      <h3 id="map-store">{copy.postgres}</h3>
      <div class="map-node map-node--implemented">
        <span class="map-node__status">{copy.implemented}</span>
        <strong>{copy.persistence}</strong>
        <small>{copy.persistenceDetail}</small>
      </div>
      <div class="map-node map-node--implemented">
        <span class="map-node__status">{copy.implemented}</span>
        <strong>{copy.recovery}</strong>
        <small>{copy.recoveryDetail}</small>
      </div>
    </section>

    <section class="map-column" aria-labelledby="map-protocols">
      <h3 id="map-protocols">{copy.protocols}</h3>
      <div class="map-node map-node--implemented">
        <span class="map-node__status">{copy.implemented}</span>
        <strong>MCP Tool clients</strong>
        <small>{copy.mcpDetail}</small>
      </div>
      <div class="map-node map-node--planned">
        <span class="map-node__status">{copy.planned}</span>
        <strong>A2A adapters</strong>
        <small>{copy.a2aDetail}</small>
      </div>
    </section>

    <section class="map-column" aria-labelledby="map-operations">
      <h3 id="map-operations">{copy.operations}</h3>
      <div class="map-node map-node--implemented">
        <span class="map-node__status">{copy.implemented}</span>
        <strong>{copy.agentService}</strong>
        <small>{copy.agentServiceDetail}</small>
      </div>
      <div class="map-node map-node--planned">
        <span class="map-node__status">{copy.planned}</span>
        <strong>{copy.controlPlane}</strong>
        <small>{copy.controlPlaneDetail}</small>
      </div>
      <div class="map-node map-node--planned">
        <span class="map-node__status">{copy.planned}</span>
        <strong>{copy.qualification}</strong>
        <small>{copy.qualificationDetail}</small>
      </div>
    </section>
  </div>
</figure>
