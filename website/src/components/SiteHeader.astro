const commands = [
  {
    group: "On this page",
    label: "Architecture map",
    detail: "What exists, what is active, and what is planned",
    href: "/#architecture",
    search: "architecture map contracts runtime durability",
  },
  {
    group: "On this page",
    label: "Current cut",
    detail: "Implemented slices and explicit gaps",
    href: "/#current-cut",
    search: "current status implemented pre-alpha gaps",
  },
  {
    group: "On this page",
    label: "Repository quickstart",
    detail: "Clone and run the validation suite",
    href: "/#quickstart",
    search: "quickstart clone cargo test repository",
  },
  {
    group: "On this page",
    label: "Road ahead",
    detail: "The path from contracts to a qualified v1",
    href: "/#roadmap",
    search: "roadmap next agent loop mcp a2a qualification",
  },
  {
    group: "Repository",
    label: "Source code",
    detail: "StateKnot/StateKnot on GitHub",
    href: "https://github.com/StateKnot/StateKnot",
    search: "github source repository code",
  },
  {
    group: "Repository",
    label: "Architecture contracts",
    detail: "RFCs, scope, scenarios, and operations notes",
    href: "https://github.com/StateKnot/StateKnot/tree/main/docs",
    search: "docs rfc architecture contracts scenarios scope",
  },
  {
    group: "Repository",
    label: "Security policy",
    detail: "Private vulnerability reporting and support policy",
    href: "https://github.com/StateKnot/StateKnot/security/policy",
    search: "security vulnerability reporting policy",
  },
];
---

<header class="site-header" data-site-header>
  <div class="header-inner">
    <a class="brand affordance" href="/" aria-label="StateKnot home">
      <svg
        class="brand-mark"
        viewBox="0 0 32 32"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M7 11.5h9a4.5 4.5 0 0 1 0 9H7v-9Z"></path>
        <path d="M25 20.5h-9a4.5 4.5 0 0 1 0-9h9v9Z"></path>
      </svg>
      <span>StateKnot</span>
    </a>

    <button
      class="search-trigger affordance"
      type="button"
      aria-label="Search StateKnot — Control or Command K"
      aria-haspopup="dialog"
      aria-controls="command-palette"
      data-command-open
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <circle cx="11" cy="11" r="6.5"></circle>
        <path d="m16 16 4 4"></path>
      </svg>
      <span class="search-trigger__label">Search the project</span>
      <span class="search-trigger__keys" aria-hidden="true">
        <kbd>⌘</kbd><kbd>K</kbd>
      </span>
    </button>

    <nav class="header-links" aria-label="Primary navigation">
      <a class="header-link affordance" href="/#roadmap">Roadmap</a>
      <a
        class="button button--primary affordance"
        href="https://github.com/StateKnot/StateKnot"
      >
        GitHub
        <span aria-hidden="true">↗</span>
      </a>
    </nav>
  </div>
</header>

<dialog
  class="command-dialog"
  id="command-palette"
  aria-labelledby="command-title"
  data-command-dialog
>
  <div class="command-head">
    <div class="command-field">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <circle cx="11" cy="11" r="6.5"></circle>
        <path d="m16 16 4 4"></path>
      </svg>
      <label class="sr-only" for="command-input" id="command-title">
        Search StateKnot
      </label>
      <input
        id="command-input"
        type="search"
        placeholder="Try “recovery” or “A2A”"
        autocomplete="off"
        spellcheck="false"
        role="combobox"
        aria-autocomplete="list"
        aria-controls="command-results"
        aria-expanded="true"
        data-command-input
      />
      <button class="command-close affordance" type="button" data-command-close>
        Close
        <kbd aria-hidden="true">Esc</kbd>
      </button>
    </div>
  </div>

  <div
    class="command-results"
    id="command-results"
    role="listbox"
    aria-label="Search results"
    data-command-results
  >
    {
      commands.map((command, index) => (
        <a
          class="command-result affordance"
          id={`command-result-${index}`}
          href={command.href}
          role="option"
          aria-selected="false"
          data-command-result
          data-command-group={command.group}
          data-command-search={`${command.label} ${command.detail} ${command.search}`}
        >
          <span>
            <span class="command-result__group">{command.group}</span>
            <strong>{command.label}</strong>
            <small>{command.detail}</small>
          </span>
          <span class="command-result__arrow" aria-hidden="true">
            ↗
          </span>
        </a>
      ))
    }
  </div>

  <div class="command-foot">
    <span><kbd>↑</kbd><kbd>↓</kbd> navigate</span>
    <span><kbd>↵</kbd> open</span>
    <span class="command-count" aria-live="polite" data-command-count>
      {commands.length} results
    </span>
  </div>
</dialog>
