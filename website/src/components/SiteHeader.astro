import { getCommandEntries } from "../data/docs";
import {
  alternateLanguageLabel,
  alternateLocalePath,
  localizePath,
  localeFromPath,
  type Locale,
} from "../data/i18n";

interface Props {
  locale?: Locale;
}

const locale = Astro.props.locale ?? localeFromPath(Astro.url.pathname);
const isChinese = locale === "zh-CN";
const commands = getCommandEntries(locale);
const alternatePath = alternateLocalePath(Astro.url.pathname);
---

<header class="site-header" data-site-header>
  <div class="header-inner">
    <a
      class="brand affordance"
      href={localizePath("/", locale)}
      aria-label={isChinese ? "StateKnot 首页" : "StateKnot home"}
    >
      <svg
        class="brand-mark"
        viewBox="0 0 32 32"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M7 11.5h9a4.5 4.5 0 0 1 0 9H7v-9Z"></path>
        <path d="M25 20.5h-9a4.5 4.5 0 0 1 0-9h9v9Z"></path>
      </svg>
      <span>StateKnot</span>
    </a>

    <button
      class="search-trigger affordance"
      type="button"
      aria-label={isChinese
        ? "搜索 StateKnot — Control 或 Command K"
        : "Search StateKnot — Control or Command K"}
      aria-haspopup="dialog"
      aria-controls="command-palette"
      data-command-open
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <circle cx="11" cy="11" r="6.5"></circle>
        <path d="m16 16 4 4"></path>
      </svg>
      <span class="search-trigger__label">
        {isChinese ? "搜索项目" : "Search the project"}
      </span>
      <span class="search-trigger__keys" aria-hidden="true">
        <kbd>⌘</kbd><kbd>K</kbd>
      </span>
    </button>

    <nav class="header-links" aria-label="Primary navigation">
      <a
        class="header-link affordance"
        href={localizePath("/docs/", locale)}
        aria-current={Astro.url.pathname.includes("/docs") ? "page" : undefined}
      >
        {isChinese ? "文档" : "Docs"}
      </a>
      <a
        class="language-link affordance"
        href={alternatePath}
        lang={isChinese ? "en" : "zh-CN"}
        hreflang={isChinese ? "en" : "zh-CN"}
        aria-label={isChinese
          ? "Switch this page to English"
          : "切换本页到中文"}
      >
        {alternateLanguageLabel(locale)}
      </a>
      <a
        class="button button--primary header-github affordance"
        href="https://github.com/StateKnot/StateKnot"
      >
        GitHub
        <span aria-hidden="true">↗</span>
      </a>
    </nav>
  </div>
</header>

<dialog
  class="command-dialog"
  id="command-palette"
  aria-labelledby="command-title"
  data-command-dialog
>
  <div class="command-head">
    <div class="command-field">
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <circle cx="11" cy="11" r="6.5"></circle>
        <path d="m16 16 4 4"></path>
      </svg>
      <label class="sr-only" for="command-input" id="command-title">
        {isChinese ? "搜索 StateKnot" : "Search StateKnot"}
      </label>
      <input
        id="command-input"
        type="search"
        placeholder={isChinese
          ? "试试“恢复”或“A2A”"
          : "Try “recovery” or “A2A”"}
        autocomplete="off"
        spellcheck="false"
        role="combobox"
        aria-autocomplete="list"
        aria-controls="command-results"
        aria-expanded="true"
        data-command-input
      />
      <button class="command-close affordance" type="button" data-command-close>
        {isChinese ? "关闭" : "Close"}
        <kbd aria-hidden="true">Esc</kbd>
      </button>
    </div>
  </div>

  <div
    class="command-results"
    id="command-results"
    role="listbox"
    aria-label={isChinese ? "搜索结果" : "Search results"}
    data-command-results
  >
    {
      commands.map((command, index) => (
        <a
          class="command-result affordance"
          id={`command-result-${index}`}
          href={command.href}
          role="option"
          aria-selected="false"
          data-command-result
          data-command-group={command.group}
          data-command-search={`${command.title} ${command.description} ${command.search}`}
        >
          <span>
            <span class="command-result__group">{command.group}</span>
            <strong>{command.title}</strong>
            <small>{command.description}</small>
          </span>
          <span class="command-result__arrow" aria-hidden="true">
            ↗
          </span>
        </a>
      ))
    }
  </div>

  <div class="command-foot">
    <span><kbd>↑</kbd><kbd>↓</kbd> {isChinese ? "选择" : "navigate"}</span>
    <span><kbd>↵</kbd> {isChinese ? "打开" : "open"}</span>
    <span class="command-count" aria-live="polite" data-command-count>
      {commands.length}
      {isChinese ? "项结果" : "results"}
    </span>
  </div>
</dialog>
