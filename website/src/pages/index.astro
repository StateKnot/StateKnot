import ArchitectureMap from "../components/ArchitectureMap.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const currentCut = [
  {
    surface: "Core domain contracts",
    state: "Implemented slice",
    evidence: "Canonical, typed, security-bounded values",
    href: "https://github.com/StateKnot/StateKnot/tree/main/crates/stateknot-core",
  },
  {
    surface: "PostgreSQL store",
    state: "Implemented slice",
    evidence: "Mandatory PostgreSQL 16 and 17 CI matrix",
    href: "https://github.com/StateKnot/StateKnot/tree/main/crates/stateknot-store-postgres",
  },
  {
    surface: "Atomic Agent admission",
    state: "Implemented slice",
    evidence: "Authenticated intent, DB clock, event, checkpoint, exact retry",
    href: "/docs/admission/",
  },
  {
    surface: "Durable Agent runs and results",
    state: "Implemented slice",
    evidence:
      "Durable ingress keys, lost-ACK convergence, verified terminal reads",
    href: "/docs/runs/",
  },
  {
    surface: "Graph compiler and recovery",
    state: "Implemented slice",
    evidence: "Canonical graphs, deterministic barriers, pinned replay",
    href: "/docs/concepts/graphs/",
  },
  {
    surface: "Durable Graph Driver",
    state: "Implemented slice",
    evidence: "Exact executables, noninitial replay, lease renewal, takeover",
    href: "/docs/runtime/",
  },
  {
    surface: "Durable Agent Loop",
    state: "Implemented slice",
    evidence: "Atomic success, failure, Wait, and cancellation commits",
    href: "/docs/agent-loop/",
  },
  {
    surface: "Durable model/tool attempts",
    state: "Implemented slice",
    evidence: "Exact providers, durable starts, streaming, terminal recovery",
    href: "/docs/invocations/",
  },
  {
    surface: "Cross-tenant fair scheduler",
    state: "Implemented slice",
    evidence: "Global weighted order and explicit starvation bounds",
    href: "/docs/fair-scheduling/",
  },
  {
    surface: "Typed Agent and model adapters",
    state: "Implemented slice",
    evidence: "Pinned schemas plus OpenAI/Anthropic unary and SSE transport",
    href: "/docs/typed-agent/",
  },
  {
    surface: "Provider-native Agent graph",
    state: "Implemented slice",
    evidence: "Recovered multi-turn tools, pinned policy, exact cancellation",
    href: "/docs/provider-native-agent/",
  },
  {
    surface: "MCP and A2A adapters",
    state: "Not shipped",
    evidence: "In v1 scope; wire boundaries remain planned",
    href: "https://github.com/StateKnot/StateKnot/blob/main/docs/v1-scope.md",
  },
];

const roadmap = [
  {
    index: "01",
    state: "Implemented",
    title: "Close the durable Graph loop",
    body: "Lifecycle handoffs, lost acknowledgements, exact-fence cleanup, and one tenant-scoped scheduler quantum now have implementation and PostgreSQL evidence.",
  },
  {
    index: "02",
    state: "Implemented",
    title: "Freeze typed provider boundaries",
    body: "Typed input/output schemas, offline profile binding, compiled examples, and OpenAI Responses plus Anthropic Messages unary/SSE adapters now have executable evidence.",
  },
  {
    index: "03",
    state: "Implemented",
    title: "Open durable Agent ingress and reads",
    body: "Tenant-scoped idempotency, fresh-ID lost-ACK convergence, and fully revalidated public run/result snapshots now have PostgreSQL evidence.",
  },
  {
    index: "04",
    state: "Implemented",
    title: "Assemble the provider-native Agent graph",
    body: "One recovered multi-turn tool path now composes transcript reconstruction, durable invocations, pinned policy and accounting, Driver, lifecycle, and exact cancellation.",
  },
  {
    index: "05",
    state: "Now",
    title: "Prove the first protocol adapter",
    body: "Carry the durable identity, policy, accounting, cancellation, and recovery contract through an authenticated MCP Tool boundary; A2A follows that proof.",
  },
  {
    index: "06",
    state: "Before v1",
    title: "Publish qualification evidence",
    body: "Run the frozen scenarios under load and failure, then publish compatibility, performance, and recovery evidence before support claims.",
  },
];
---

<BaseLayout>
  <SiteHeader />

  <main id="main-content" tabindex="-1">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="hero-status">Pre-alpha · no stable public API</p>
          <h1 id="hero-title">
            Durable agent orchestration, written for Rust.
          </h1>
          <p class="hero-lede">
            StateKnot now runs typed root Graphs through PostgreSQL-backed crash
            recovery, atomic Agent admission, durable model/tool attempts,
            lifecycle commits, weighted cross-tenant scheduling, durable ingress
            keys, verified run/result reads, typed Agent contracts, the first
            OpenAI/Anthropic adapters, and a recovered provider-native
            multi-turn Agent graph. Stable service APIs and MCP/A2A protocol
            adapters remain under development.
          </p>
          <div class="hero-actions">
            <a class="button button--primary affordance" href="/docs/"
              >Read the docs</a
            >
            <a
              class="text-link affordance"
              href="https://github.com/StateKnot/StateKnot"
              >Inspect source <span aria-hidden="true">↗</span></a
            >
          </div>
        </div>

        <figure class="hero-terminal" aria-labelledby="terminal-caption">
          <figcaption id="terminal-caption">Repository validation</figcaption>
          <pre
            tabindex="0"
            aria-label="Repository validation: workspace tests and durable Graph Driver integration tests on PostgreSQL versions 16 and 17, Apache-2.0 license, pre-alpha status"><code><span class="code-muted">$</span> <span aria-hidden="true" data-type-line data-text="cargo test --workspace --all-targets --all-features --locked">cargo test --workspace --all-targets --all-features --locked</span>

<span class="code-muted">$</span> cargo test -p stateknot-runtime \
    --test postgres --locked

<span class="code-key">CI matrix</span>  PostgreSQL 16 / 17
<span class="code-key">License</span>    Apache-2.0
<span class="code-key">Status</span>     <span class="code-accent">pre-alpha</span></code></pre>
        </figure>
      </div>
    </section>

    <section
      class="section architecture-section"
      id="architecture"
      aria-labelledby="architecture-title"
    >
      <div class="section-head">
        <h2 id="architecture-title">
          The architecture is a set of evidence boundaries.
        </h2>
        <p>
          Wire protocols stay outside the stable domain. External work stays
          outside database transactions. Recovery decisions are derived from
          bounded, integrity-checked facts.
        </p>
      </div>
      <ArchitectureMap />
    </section>

    <section
      class="section current-section"
      id="current-cut"
      aria-labelledby="current-title"
    >
      <div class="section-head section-head--narrow">
        <h2 id="current-title">Current cut, without roadmap theatre.</h2>
        <p>
          “Implemented” means code exists in the pre-alpha repository. It does
          not mean the API is stable or the framework is ready for production.
        </p>
      </div>

      <div class="spec-head" aria-hidden="true">
        <span>Surface</span>
        <span>Repository state</span>
        <span>Evidence</span>
        <span>Source</span>
      </div>
      <ul class="spec-list">
        {
          currentCut.map((item) => (
            <li class="spec-row">
              <strong>{item.surface}</strong>
              <span>{item.state}</span>
              <span>{item.evidence}</span>
              <a
                class="spec-link affordance"
                href={item.href}
                aria-label={`Inspect ${item.surface} source`}
              >
                Inspect <span aria-hidden="true">↗</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section
      class="quickstart"
      id="quickstart"
      aria-labelledby="quickstart-title"
    >
      <div class="quickstart-inner">
        <div class="quickstart-copy">
          <h2 id="quickstart-title">
            Validate the repository before trusting the claims.
          </h2>
          <p>
            The facade crate is intentionally unpublished. Today’s honest
            quickstart validates the repository first, then runs a real typed
            contract example without pretending to complete the public Agent
            path.
          </p>
          <a class="dark-link affordance" href="/docs/getting-started/"
            >Open the contributor tutorial <span aria-hidden="true">→</span></a
          >
        </div>

        <div class="quickstart-code">
          <div class="code-label-row">
            <span>Shell · contributor checkout</span>
            <button
              class="copy-button affordance"
              type="button"
              data-copy-button
              data-copy-target="quickstart-code"
            >
              <span data-copy-label aria-live="polite">Copy</span>
            </button>
          </div>
          <pre
            id="quickstart-code"
            tabindex="0"
            aria-label="Contributor quickstart commands"><code>git clone https://github.com/StateKnot/StateKnot.git
cd StateKnot
cargo fmt --all --check
cargo test --workspace --all-targets --all-features --locked</code></pre>
        </div>
      </div>
    </section>

    <section
      class="section roadmap-section"
      id="roadmap"
      aria-labelledby="roadmap-title"
    >
      <div class="section-head section-head--narrow">
        <h2 id="roadmap-title">The road ahead is ordered by proof.</h2>
        <p>
          The recovered provider-native path now survives crashes, retries,
          stale workers, cancellation, and lost acknowledgements. The first MCP
          boundary must preserve those proofs; A2A follows it.
        </p>
      </div>

      <ol class="roadmap-list">
        {
          roadmap.map((item) => (
            <li class="roadmap-item">
              <span class="roadmap-index" aria-hidden="true">
                {item.index}
              </span>
              <div>
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </div>
              <span class="roadmap-state">{item.state}</span>
            </li>
          ))
        }
      </ol>

      <a class="text-link affordance" href="/docs/status/"
        >Open implementation status <span aria-hidden="true">→</span></a
      >
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
