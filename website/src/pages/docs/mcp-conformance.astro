import DocsLayout from "../../layouts/DocsLayout.astro";

const reproduceCommand = `cd conformance/mcp-client
npm ci --ignore-scripts
cd ../..
bash conformance/mcp-client/run-2026-07-28.sh`;

const scenarios = [
  ["tools_call", 2, 0],
  ["request-metadata", 5, 3],
  ["http-standard-headers", 3, 8],
  ["http-custom-headers", 18, 0],
  ["http-invalid-tool-headers", 11, 0],
  ["json-schema-ref-no-deref", 1, 0],
  ["sep-2322-client-request-state", 5, 0],
] as const;
---

<DocsLayout
  title="MCP conformance claims stop at the evidence."
  description="Inspect the pinned official runner, all seven non-OAuth client scenario results, reproducible CI gate, and the OAuth/server boundary StateKnot does not claim."
  section="MCP conformance status"
>
  <aside
    class="docs-callout docs-callout--boundary"
    aria-labelledby="mcp-conformance-boundary-title"
  >
    <h2 id="mcp-conformance-boundary-title">Current claim</h2>
    <p>
      The general stateless Tool client passes all seven scored non-OAuth client
      scenarios in the frozen MCP 2026-07-28 requirement set. The remaining 25
      scored OAuth scenarios are not implemented, so StateKnot makes no complete
      client, server, authorization-server, or SDK-tier conformance claim.
    </p>
  </aside>

  <section aria-labelledby="mcp-conformance-input-title">
    <h2 id="mcp-conformance-input-title">Frozen evaluation input</h2>
    <dl class="docs-definition-list">
      <div>
        <dt>Runner</dt>
        <dd><code>@modelcontextprotocol/conformance@0.2.0-alpha.11</code></dd>
      </div>
      <div>
        <dt>Integrity</dt>
        <dd>
          <code
            >sha512-imPK9tx5gQsL6ZKQq4MrsyDYfSaIwpRmX6+ogjbeAXs9LGvxkBxWcY7KcS7TvwaBk/ZiVWl6b/naF4q83UwDRA==</code
          >
        </dd>
      </div>
      <div>
        <dt>Source identity</dt>
        <dd><code>c321dd32035556e6769d3724a8ee97d87c3faaac</code></dd>
      </div>
      <div>
        <dt>Requirement revision</dt>
        <dd><code>2026-07-28</code></dd>
      </div>
      <div>
        <dt>Inventory</dt>
        <dd>
          69 scored scenarios: 37 server, seven non-OAuth client, and 25 OAuth
          client scenarios.
        </dd>
      </div>
      <div>
        <dt>Expected failures</dt>
        <dd>None.</dd>
      </div>
    </dl>
  </section>

  <section aria-labelledby="mcp-conformance-result-title">
    <h2 id="mcp-conformance-result-title">Observed result</h2>
    <div
      class="docs-table-wrap"
      tabindex="0"
      aria-label="Official MCP client scenario results"
    >
      <table>
        <thead>
          <tr
            ><th>Official client scenario</th><th>Success</th><th>Skipped</th
            ><th>Failure</th></tr
          >
        </thead>
        <tbody>
          {
            scenarios.map(([name, success, skipped]) => (
              <tr>
                <td>
                  <code>{name}</code>
                </td>
                <td>{success}</td>
                <td>{skipped}</td>
                <td>0</td>
              </tr>
            ))
          }
          <tr><th>Total</th><th>45</th><th>11</th><th>0</th></tr>
        </tbody>
      </table>
    </div>
    <p>
      Three metadata skips are optional Roots, Sampling, and Elicitation
      declarations StateKnot does not advertise. Eight standard-header skips are
      lifecycle, Resource, and Prompt methods outside this Tool client. Skips
      are not counted as passes and grant no capability claim.
    </p>
  </section>

  <section aria-labelledby="mcp-conformance-proof-title">
    <h2 id="mcp-conformance-proof-title">Reproduce the mandatory gate</h2>
    <div class="docs-code" data-code-block>
      <div class="docs-code-head">
        <span>Shell · pinned official runner</span>
        <button
          class="copy-button affordance"
          type="button"
          data-copy-button
          data-copy-target="mcp-conformance-run-code"
        >
          <span data-copy-label aria-live="polite">Copy</span>
        </button>
      </div>
      <pre
        id="mcp-conformance-run-code"
        tabindex="0"><code>{reproduceCommand}</code></pre>
    </div>
    <p>
      The script builds the real Rust driver, runs each scenario, stores raw
      official output, and fails on missing, duplicate, unexpected, failed, or
      count-drifted evidence. CI pins Rust 1.88.0 and Node.js 24.19.0 and runs
      the same command without an expected-failures file.
    </p>
  </section>

  <section aria-labelledby="mcp-conformance-surfaces-title">
    <h2 id="mcp-conformance-surfaces-title">
      Two Tool surfaces, two guarantees
    </h2>
    <p>
      <a href="/docs/mcp-client/"><code>McpClient</code></a> accepts the broad valid
      Tool shape used by the official fixture. <a href="/docs/mcp-remote-tool/"
        ><code>McpRemoteTool</code></a
      > remains stricter: reviewed input/output schemas, pinned server identity, validated
      structured output, durable-before-dispatch state, and explicit reconciliation
      after an ambiguous write. Passing the general fixture does not weaken that durable
      contract.
    </p>
  </section>

  <section aria-labelledby="mcp-conformance-next-title">
    <h2 id="mcp-conformance-next-title">Remaining release gates</h2>
    <p>
      Complete client conformance requires a separately security-reviewed OAuth
      implementation and all 25 frozen OAuth scenarios. MCP Server, Resources,
      Prompts, Tasks, and SDK-tier claims each require their own implementation
      and official evidence. Read the <a
        href="https://github.com/StateKnot/StateKnot/blob/main/docs/mcp-conformance.md"
        >complete evidence report</a
      > and the <a href="https://github.com/modelcontextprotocol/conformance"
        >official runner source</a
      >.
    </p>
  </section>
</DocsLayout>
