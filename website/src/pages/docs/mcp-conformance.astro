import DocsLayout from "../../layouts/DocsLayout.astro";

const reproduceCommand = `cd conformance/mcp-client
npm ci --ignore-scripts
cd ../..
bash conformance/mcp-client/run-2026-07-28.sh
bash conformance/mcp-server/run-2026-07-28.sh`;

const clientResults = [
  ["Required non-OAuth", 7, 45, 11, 0],
  ["Required OAuth", 25, 328, 0, 0],
  ["Required total", 32, 373, 11, 0],
  ["Explicitly not scored", 7, 33, 6, 17],
] as const;

const serverResults = [
  ["Required total", 37, 114, 5, 1, 0, 0],
  ["Pending, unscored gates", 3, 32, 0, 0, 0, 0],
  ["Reported Tasks extension", 10, 12, 1, 0, 30, 0],
] as const;
---

<DocsLayout
  title="MCP conformance claims stop at the evidence."
  description="Inspect the pinned runner, all 32 scored Client and 37 scored Server scenarios, reproducible CI gates, and the exact Tasks/stable-API boundary."
  section="MCP conformance status"
>
  <aside
    class="docs-callout docs-callout--boundary"
    aria-labelledby="mcp-conformance-boundary-title"
  >
    <h2 id="mcp-conformance-boundary-title">Current claim</h2>
    <p>
      The general stateless Tool client and its OAuth provider pass all 32
      scored client scenarios in the frozen MCP 2026-07-28 requirement set,
      including all 25 OAuth scenarios. The strict Server transport passes all
      37 scored Server scenarios. These are pre-alpha Client/Server-profile
      evidence claims, not an authorization-server, Tasks/extension, stable-API,
      SDK-tier, or complete-framework claim.
    </p>
  </aside>

  <section aria-labelledby="mcp-conformance-input-title">
    <h2 id="mcp-conformance-input-title">Frozen evaluation input</h2>
    <dl class="docs-definition-list">
      <div>
        <dt>Runner</dt>
        <dd><code>@modelcontextprotocol/conformance@0.2.0-alpha.11</code></dd>
      </div>
      <div>
        <dt>Integrity</dt>
        <dd>
          <code
            >sha512-imPK9tx5gQsL6ZKQq4MrsyDYfSaIwpRmX6+ogjbeAXs9LGvxkBxWcY7KcS7TvwaBk/ZiVWl6b/naF4q83UwDRA==</code
          >
        </dd>
      </div>
      <div>
        <dt>Source identity</dt>
        <dd><code>c321dd32035556e6769d3724a8ee97d87c3faaac</code></dd>
      </div>
      <div>
        <dt>Requirement revision</dt>
        <dd><code>2026-07-28</code></dd>
      </div>
      <div>
        <dt>Inventory</dt>
        <dd>
          69 scored scenarios: 37 server, seven non-OAuth client, and 25 OAuth
          client scenarios.
        </dd>
      </div>
      <div>
        <dt>Expected failures</dt>
        <dd>None.</dd>
      </div>
    </dl>
  </section>

  <section aria-labelledby="mcp-conformance-result-title">
    <h2 id="mcp-conformance-result-title">Observed result</h2>
    <div
      class="docs-table-wrap"
      tabindex="0"
      aria-label="Official MCP client scenario results"
    >
      <table>
        <thead>
          <tr
            ><th>Official inventory</th><th>Scenarios</th><th>Success</th><th
              >Skipped</th
            ><th>Failure</th></tr
          >
        </thead>
        <tbody>
          {
            clientResults.map(
              ([name, scenarios, success, skipped, failure]) => (
                <tr>
                  <td>{name}</td>
                  <td>{scenarios}</td>
                  <td>{success}</td>
                  <td>{skipped}</td>
                  <td>{failure}</td>
                </tr>
              ),
            )
          }
        </tbody>
      </table>
    </div>
    <p>
      Three metadata skips are optional Roots, Sampling, and Elicitation
      declarations StateKnot does not advertise. Eight standard-header skips are
      lifecycle, Resource, and Prompt methods outside this Tool client. Skips
      are not counted as passes and grant no capability claim. The seven
      final-row scenarios are official extensions or post-release additions that
      the frozen set explicitly runs but never scores; their failures remain
      reported and outside StateKnot's claim.
    </p>

    <div
      class="docs-table-wrap"
      tabindex="0"
      aria-label="Official MCP Server scenario results"
    >
      <table>
        <thead>
          <tr>
            <th>Official Server inventory</th><th>Scenarios</th><th>Success</th
            ><th>Skipped</th><th>Info</th><th>Failure</th><th>Warning</th>
          </tr>
        </thead>
        <tbody>
          {
            serverResults.map(
              ([name, scenarios, success, skipped, info, failure, warning]) => (
                <tr>
                  <td>{name}</td>
                  <td>{scenarios}</td>
                  <td>{success}</td>
                  <td>{skipped}</td>
                  <td>{info}</td>
                  <td>{failure}</td>
                  <td>{warning}</td>
                </tr>
              ),
            )
          }
        </tbody>
      </table>
    </div>
    <p>
      Five required skips remain optional capability branches, and the one Info
      is a non-warning SSE observation. The three pending schema/header
      scenarios add exact regression evidence but do not inflate the 37-scenario
      score. Tasks remain unadvertised and unimplemented; their reported
      failures are evidence of that boundary, not expected failures.
    </p>
  </section>

  <section aria-labelledby="mcp-conformance-proof-title">
    <h2 id="mcp-conformance-proof-title">Reproduce the mandatory gate</h2>
    <div class="docs-code" data-code-block>
      <div class="docs-code-head">
        <span>Shell · pinned official runner</span>
        <button
          class="copy-button affordance"
          type="button"
          data-copy-button
          data-copy-target="mcp-conformance-run-code"
        >
          <span data-copy-label aria-live="polite">Copy</span>
        </button>
      </div>
      <pre
        id="mcp-conformance-run-code"
        tabindex="0"><code>{reproduceCommand}</code></pre>
    </div>
    <p>
      The scripts build the real Rust drivers and run the complete frozen Client
      and Server inventories. Independent verifiers require every exact count
      above, including reported-but-unclaimed rows. CI pins Rust 1.88.0 and
      Node.js 24.19.0 and uses no expected-failures file. The Server fixture
      uses the production HTTP transport; StateKnot registries and policies have
      separate real-HTTP tests.
    </p>
  </section>

  <section aria-labelledby="mcp-conformance-surfaces-title">
    <h2 id="mcp-conformance-surfaces-title">
      Two Tool surfaces, two guarantees
    </h2>
    <p>
      <a href="/docs/mcp-client/"><code>McpClient</code></a> accepts the broad valid
      Tool shape used by the official fixture. <a href="/docs/mcp-remote-tool/"
        ><code>McpRemoteTool</code></a
      > remains stricter: reviewed input/output schemas, pinned server identity, validated
      structured output, durable-before-dispatch state, and explicit reconciliation
      after an ambiguous write. Passing the general fixture does not weaken that durable
      contract.
    </p>
  </section>

  <section aria-labelledby="mcp-conformance-next-title">
    <h2 id="mcp-conformance-next-title">Remaining release gates</h2>
    <p>
      Remaining independent gates include Tasks, the seven currently unscored
      Client extensions, stable SDK/API review, release artifacts, and full
      production qualification. Read the <a
        href="https://github.com/StateKnot/StateKnot/blob/main/docs/mcp-conformance.md"
        >complete evidence report</a
      > and the <a href="https://github.com/modelcontextprotocol/conformance"
        >official runner source</a
      >.
    </p>
  </section>
</DocsLayout>
