import DocsLayout from "../../layouts/DocsLayout.astro";

const buildCode = `let skill = McpServerSkillDefinition::new(
    "skill://code-review/SKILL.md",
    [
        McpServerSkillFile::text(
            "SKILL.md",
            "text/markdown",
            include_str!("skills/code-review/SKILL.md"),
        )?,
        McpServerSkillFile::text(
            "references/checklist.md",
            "text/markdown",
            include_str!("skills/code-review/references/checklist.md"),
        )?,
    ],
)?;

let mut skills = McpServerSkillCatalogBuilder::default();
skills.register(skill)?;

let app = McpServerApplicationBuilder::new(options)
    .with_skills(skills.build()?, skill_authorization)?
    .build()?;`;

const clientCode = `let client = McpClient::connect(
    endpoint,
    McpClientIdentity::new("orders-agent", env!("CARGO_PKG_VERSION"))?,
    authorization,
    McpClientOptions::for_skills(),
).await?;

let host = McpSkillHost::new(
    client,
    McpSkillOrigin::new("production/orders-mcp")?,
    Arc::new(application_skill_policy),
    McpSkillHostOptions::default(),
)?;

let catalog = host.list_skills().await?;
let selected = catalog.find_uri("skill://code-review/SKILL.md")
    .ok_or(AppError::SkillUnavailable)?;
let active = Arc::new(host.activate(selected).await?);

let file = active.read_file("references/checklist.md").await?;
model_context.push_untrusted_skill_file(file.identity(), file.bytes())?;

let guarded = Arc::new(McpSkillBoundTool::new(
    Arc::clone(&active),
    ticket_create_tool,
    Arc::new(postgres_store.clone()),
    McpSkillHostCodeExecution::NotPossible,
)?);
tool_registry.register(guarded)?;
let tools = tool_registry.build();`;

const verifyCode = `cargo test -p stateknot-integrations mcp_server_skill --locked
cargo test -p stateknot-integrations --test mcp_skills_server --locked
cargo test -p stateknot-integrations mcp_skill_host --locked
cargo test -p stateknot-integrations --test mcp_skills_host --locked`;
---

<DocsLayout
  title="Publish and activate manifest-bound Agent Skills over MCP."
  description="Use the Final SEP-2640 static Server and Client/Host profiles with immutable manifests, origin-scoped approval, lazy verified reads, and explicit execution gates."
  section="MCP Skills profiles"
>
  <aside
    class="docs-callout docs-callout--boundary"
    aria-labelledby="mcp-skills-boundary-title"
  >
    <h2 id="mcp-skills-boundary-title">
      Implemented static Server and Client/Host profiles, pre-alpha API
    </h2>
    <p>
      StateKnot now serves the Final SEP-2640
      <code>io.modelcontextprotocol/skills</code> extension on MCP
      <code>2026-07-28</code>. The Server publishes immutable complete
      manifests; the separate Client/Host verifies and activates them with
      host-assigned origin and fresh policy approval. Dynamic manifests,
      persisted activation approval/acting windows, disk installation,
      signatures, and automatic discovery-to-Agent composition remain outside
      this claim.
    </p>
  </aside>

  <section aria-labelledby="mcp-skills-wire-title">
    <h2 id="mcp-skills-wire-title">
      One immutable snapshot drives every response
    </h2>
    <p>
      The server freezes each <code>SKILL.md</code> and supporting file at startup.
      <code>skills/list</code>, <code>skills/get</code>, and
      <code>resources/read</code> use those same bytes, so a manifest cannot drift
      away from the content returned later.
    </p>
    <div
      class="docs-table-wrap"
      tabindex="0"
      aria-label="MCP Skills profile guarantees"
    >
      <table>
        <thead><tr><th>Boundary</th><th>Guarantee</th></tr></thead>
        <tbody>
          <tr
            ><td>Discovery</td><td
              >Bounded pagination, deterministic order, TTL and cache scope.</td
            ></tr
          >
          <tr
            ><td>Manifest</td><td
              >Every file appears once with exact raw-byte SHA-256 and size.</td
            ></tr
          >
          <tr
            ><td>Reads</td><td
              >Text or Base64 content from the retained immutable snapshot.</td
            ></tr
          >
          <tr
            ><td>Policy</td><td
              >Authentication, exact scopes and dynamic authorization before
              disclosure.</td
            ></tr
          >
          <tr
            ><td>Limits</td><td
              >512 files and 16 MiB per Skill, plus aggregate catalog ceilings.</td
            ></tr
          >
          <tr
            ><td>Host</td><td
              >Origin + URI identity, approval before reads, exact digest/size/
              frontmatter verification, and manifest-only lazy access.</td
            ></tr
          >
          <tr
            ><td>Execution</td><td
              >Exact owner/version/descriptor binding plus a fresh,
              acting-window-bound policy permit before every execution and
              recovery probe, with exact durable correlation and bounded
              schema-bound input. A payload-redacted immutable receipt must
              commit before provider I/O.</td
            ></tr
          >
        </tbody>
      </table>
    </div>
  </section>

  <section aria-labelledby="mcp-skills-client-title">
    <h2 id="mcp-skills-client-title">
      Activate through the verification-first Host
    </h2>
    <div class="docs-code" data-code-block>
      <div class="docs-code-head">
        <span>Rust</span>
        <button
          class="copy-button affordance"
          type="button"
          data-copy-button
          data-copy-target="mcp-skills-client-code"
        >
          <span data-copy-label aria-live="polite">Copy</span>
        </button>
      </div>
      <pre
        id="mcp-skills-client-code"
        tabindex="0"><code>{clientCode}</code></pre>
    </div>
    <p>
      Listing never prefetches Skill files. Preserve each verified file's origin
      identity in model-visible context. Register <code>McpSkillBoundTool</code>
      instead of the raw provider so the ordinary durable Tool runtime enforces an
      exact policy decision before execution and reconciliation. Frontmatter
      <code>allowed-tools</code> is review input, never an authorization grant. Policy
      returns version-pinned grant evidence, and the required durable receipt sink
      fails closed before dispatch if that evidence cannot commit.
    </p>
  </section>

  <section aria-labelledby="mcp-skills-validation-title">
    <h2 id="mcp-skills-validation-title">
      Reject ambiguous or unsafe packages at startup
    </h2>
    <p>
      The registry rejects duplicate YAML keys at any depth, malformed Agent
      Skills fields, alias expansion beyond the materialized-value budget,
      name/URI mismatch, traversal and non-canonical paths, overlapping resource
      URIs, incomplete packages, and oversized catalogs. Unknown frontmatter
      fields remain data and are preserved without becoming authority.
    </p>
  </section>

  <section aria-labelledby="mcp-skills-build-title">
    <h2 id="mcp-skills-build-title">Build the static server surface</h2>
    <div class="docs-code" data-code-block>
