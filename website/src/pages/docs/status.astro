import DocsLayout from "../../layouts/DocsLayout.astro";

const capabilities = [
  {
    state: "Implemented",
    className: "status-implemented",
    title: "Core domain contracts",
    body: "Bounded canonical types plus compiled root-graph validation and deterministic route/reducer/successor barrier planning.",
  },
  {
    state: "Implemented",
    className: "status-implemented",
    title: "PostgreSQL durability slice",
    body: "PostgreSQL 16/17 migrations, journal, checkpoints, leases, ledgers, barriers, waits, outbox, quarantine, delayed wakeups, pinned graphs, and durable fairness reservations.",
  },
  {
    state: "Implemented",
    className: "status-implemented",
    title: "Atomic Agent admission",
    body: "Immutable authenticated intent, deterministic finite budgets, database-clock admission, first event, initial checkpoint, scheduler visibility, exact retries, and fully verified loads.",
  },
  {
    state: "Implemented",
    className: "status-implemented",
    title: "Durable Agent runs and results",
    body: "Tenant-scoped durable ingress keys, fresh-candidate retry convergence, conflict detection, verified public lifecycle snapshots, and success/failure/cancellation outcomes.",
  },
  {
    state: "Implemented",
    className: "status-implemented",
    title: "Durable Graph Driver",
    body: "Offline executable schema/reducer/node closure, full checkpoint-state and bounded noninitial replay validation, durable-before-dispatch execution, near-expiry lease refresh, monotonic renewal, durable cancellation polling, Continue barriers, and typed lifecycle handoffs.",
  },
  {
    state: "Implemented",
    className: "status-implemented",
    title: "Lifecycle and durable Agent Loop",
    body: "Atomic Wait/success/failure/cancellation handoff commits, trusted lifecycle evidence validation, exact lost-ack recovery, bounded exact-fence cleanup, and one tenant-scoped scheduler quantum.",
  },
  {
    state: "Implemented",
    className: "status-implemented",
    title: "Durable model/tool execution",
    body: "Exact immutable provider registries, trusted budget admission, durable-before-dispatch attempts, unary and durably-sunk streaming models, tool ambiguity, and no-dispatch terminal recovery.",
  },
  {
    state: "Implemented",
    className: "status-implemented",
    title: "Cross-tenant fair scheduling",
    body: "Replica-global smooth weighted reservations, exact cycle shares, explicit reservation-count starvation bounds, concurrency-safe lost-ACK recovery, and bounded retention.",
  },
  {
    state: "Implemented",
    className: "status-implemented",
    title: "Typed Agent and first-party model adapters",
    body: "Generated canonical digest-pinned input/output schemas, offline provider-profile binding, bounded typed codecs, and OpenAI Responses plus Anthropic Messages unary/SSE adapters with explicit transport controls.",
  },
  {
    state: "Implemented",
    className: "status-implemented",
    title: "Provider-native Agent graph",
    body: "A digest-pinned prebuilt multi-turn model/tool graph with sequential tools, provider-native transcript recovery, local policy evidence, exact accounting, no-redispatch terminal recovery, and two-phase cancellation confirmation.",
  },
  {
    state: "Active work",
    className: "status-active",
    title: "Advanced execution and service boundary",
    body: "Artifact retrieval, parallel sibling/tool ordering, output repair, loop/subgraph semantics, a stable public cancellation ingress, and the one-call Agent service remain active work.",
  },
  {
    state: "Not shipped",
    className: "status-planned",
    title: "Stable end-to-end Agent API",
    body: "The prebuilt durable path exists, but no stable one-call execution service, published crate, compatibility guarantee, or production support claim exists yet.",
  },
  {
    state: "Not shipped",
    className: "status-planned",
    title: "MCP and A2A adapters",
    body: "Both protocols are in v1 scope, but protocol-specific wire adapters and conformance evidence have not shipped.",
  },
  {
    state: "Not shipped",
    className: "status-planned",
    title: "Production server and operations",
    body: "HTTP/SSE roles, authentication, policy, observability, role isolation, general retention, failover, restore, OCI delivery, and release qualification remain ahead.",
  },
];
---

<DocsLayout
  title="Read implementation status before API shape."
  description="StateKnot is pre-alpha: the provider-native multi-turn Agent graph now runs over durable admission, invocations, recovery, lifecycle, and fair scheduling; stable service APIs, MCP/A2A adapters, advanced graph semantics, and production qualification remain unfinished."
  section="Implementation status"
>
  <section aria-labelledby="status-matrix-title">
    <h2 id="status-matrix-title">Capability matrix</h2>
    <ul class="status-list">
      {
        capabilities.map((capability) => (
          <li class="status-item">
            <span class:list={["status-badge", capability.className]}>
              {capability.state}
            </span>
            <div>
              <h3>{capability.title}</h3>
              <p>{capability.body}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="claim-title">
    <h2 id="claim-title">What “implemented” means</h2>
    <p>
      Code and executable tests exist in the repository. It does not mean the
      API is stable, the crate is published, operational release gates pass, or
      compatibility support has started. A v1 capability is supported only when
      implementation, tests, documentation, compatibility evidence, and release
      gates ship together.
    </p>
  </section>

  <section aria-labelledby="next-proof-title">
    <h2 id="next-proof-title">The next proof boundary</h2>
    <p>
      The provider-native graph now proves one multi-turn Tool path can crash,
      recover, confirm cancellation with exact usage, and return a typed result
      without redispatching committed work. The next proof boundary carries
      those same durable identities and failure semantics through the first MCP
      Tool adapter, including authenticated capability negotiation, bounded wire
      data, cancellation, and crash recovery. A2A follows only after that
      protocol boundary is executable rather than aspirational.
    </p>
  </section>

