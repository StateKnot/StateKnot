  },
  {
    state: "Implemented",
    className: "status-implemented",
    title: "AgentService v1 embedding boundary",
    body: "Exact-version deployment binding, authorization before deployment/run/key existence disclosure, tenant-scoped submission recovery, verified reads, and caller-retained two-phase cancellation identities.",
  },
  {
    state: "Implemented",
    className: "status-implemented",
    title: "Strict MCP Remote Tool profile",
    body: "One MCP 2026-07-28 client-side Tool binding with modern stateless discovery, complete JSON transport, exact local schema/server pins, attempt-scoped authorization, and reconciliation-first ambiguous writes.",
  },
  {
    state: "Active work",
    className: "status-active",
    title: "Advanced execution and service boundary",
    body: "Artifact retrieval, parallel sibling/tool ordering, output repair, loop/subgraph semantics, stable network transport, protocol-specific outbox dispatch, and combined durable MCP qualification remain active work.",
  },
  {
    state: "Not shipped",
    className: "status-planned",
    title: "Stable network Agent API",
    body: "The versioned embedding facade exists, but no stable HTTP/gRPC/SSE API, published crate, compatibility guarantee, or production support claim exists yet.",
  },
  {
    state: "Not shipped",
    className: "status-planned",
    title: "Broader MCP and A2A profiles",
    body: "MCP server, resources/prompts and broader client features, official MCP conformance evidence, and all A2A client/server bindings remain unshipped.",
  },
  {
    state: "Not shipped",
    className: "status-planned",
    title: "Production server and operations",
    body: "HTTP/SSE roles, authentication, policy, observability, role isolation, general retention, failover, restore, OCI delivery, and release qualification remain ahead.",
  },
