const capabilities = [
  {
    state: "Implemented",
    className: "status-implemented",
    title: "Bounded host qualification evidence",
    body: "The public-alpha stateknot-testkit owns monotonic phases, bounded HDR distributions, checked safety counters, a closed fault matrix and canonical integrity envelopes. A reduced PostgreSQL 16/17 profile exercises real host admission, SSE, operations, dependency recovery and rolling replacement, but is always non-release evidence; reference load, soak, failover and provenance remain open.",
