import SiteFooter from "../../components/SiteFooter.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="页面不存在 — StateKnot"
  description="请求的 StateKnot 页面不存在。"
  indexable={false}
  locale="zh-CN"
>
  <SiteHeader locale="zh-CN" />
  <main id="main-content" class="not-found" tabindex="-1">
    <p class="hero-status">404 · 路由不存在</p>
    <h1>这条路径没有耐久后继。</h1>
    <p>页面可能已经移动，或者该链接指向 StateKnot 尚未发布的能力。</p>
    <a class="button button--primary affordance" href="/zh/">返回首页</a>
  </main>
  <SiteFooter locale="zh-CN" />
</BaseLayout>
