import DocsLayout from "../../../layouts/DocsLayout.astro";

const oauthCode = `use std::sync::Arc;

use stateknot_integrations::{
    McpClient, McpClientIdentity, McpClientOptions,
    McpOAuthAuthorization, McpOAuthOptions, McpOAuthRegistration,
    McpOAuthResource, ProviderEndpoint,
};

let endpoint = ProviderEndpoint::https("https://mcp.example.com/mcp/")?;
let resource = McpOAuthResource::from_endpoint(&endpoint)?;
let registration = McpOAuthRegistration::client_metadata_document(
    "https://agent.example.com/oauth/client-metadata.json",
)?;
let policy = McpOAuthOptions::native(
    "http://127.0.0.1:49152/callback",
    "Inventory Agent",
    registration,
)?;
let authorization = Arc::new(
    McpOAuthAuthorization::new_with_stores(
        resource,
        policy,
        user_agent,
        encrypted_credential_store,
        expiring_pkce_state_store,
    )
    .await?,
);

let client = McpClient::connect(
    endpoint,
    McpClientIdentity::new("inventory-agent", "1.0.0")?,
    authorization,
    McpClientOptions::default().with_maximum_authorization_retries(1)?,
)
.await?;`;

const verifyCode = `cargo test -p stateknot-integrations --test mcp_client_contract --locked
bash conformance/mcp-client/run-2026-07-28.sh`;
---

<DocsLayout
  title="授权一个 MCP Resource，不扩大信任边界。"
  description="配置 StateKnot Challenge-driven MCP OAuth Client、耐久 Credential Store、精确 Callback 边界、有界 Replay 与冻结官方证据。"
  section="MCP OAuth Client"
  locale="zh-CN"
>
  <aside
    class="docs-callout docs-callout--boundary"
    aria-labelledby="mcp-oauth-boundary-title"
  >
    <h2 id="mcp-oauth-boundary-title">已实现的 pre-alpha Profile</h2>
    <p>
      交互式 Authorization Code Profile 已通过冻结 MCP 2026-07-28 Requirement
      Set 要求的全部 25 个计分 OAuth Client 场景。Client Credentials、Enterprise
      Managed Authorization、DPoP、Workload Identity Federation、稳定 SDK 支持与
      MCP Server Authorization 尚未实现，也不做支持声明。
    </p>
  </aside>

  <section aria-labelledby="mcp-oauth-connect-title">
    <h2 id="mcp-oauth-connect-title">将 OAuth 绑定到一个精确 Resource</h2>
    <p>
      生产 MCP Resource 强制 HTTPS。Host 提供可信 User Agent，以及加密、
      Tenant-scoped Credential Store 与带 Expiry 的 PKCE State Store。In-memory
      Constructor 只适用于明确不承诺跨重启恢复的进程。
    </p>
    <div class="docs-code" data-code-block>
      <div class="docs-code-head">
        <span>Rust · 耐久 OAuth Binding</span>
        <button
          class="copy-button affordance"
          type="button"
          data-copy-button
          data-copy-target="zh-mcp-oauth-code"
        >
          <span data-copy-label aria-live="polite">复制</span>
        </button>
      </div>
      <pre id="zh-mcp-oauth-code" tabindex="0"><code>{oauthCode}</code></pre>
    </div>
    <p>
      Credential 由外部 Provision 时使用 Pre-registration；发布 HTTPS Client
      Metadata Document 时使用 CIMD；只有部署 Policy 明确接受时才启用 DCR
      Fallback。
    </p>
  </section>

  <section aria-labelledby="mcp-oauth-flow-title">
    <h2 id="mcp-oauth-flow-title">让 Challenge Recovery 保持有限</h2>
    <ol>
      <li>不存在可用 Credential 时，Client 先匿名发送。</li>
      <li>
        有界 401/403 Bearer Challenge 驱动 Protected-resource 与
        Authorization-server Discovery。
      </li>
      <li>
        StateKnot 恢复 Issuer-bound Credential，或按照 Policy 通过
        Pre-registration、CIMD、DCR 启动 PKCE Flow。
      </li>
      <li>
        Host 打开已校验 Authorization URL，并从精确注册 Origin 与 Path 返回完整
        Callback URL。
      </li>
      <li>
        Token Exchange 成功后，用新 JSON-RPC ID 重放一次 MCP Method。Timeout 与
        Ambiguous Dispatch 永不重放。
      </li>
    </ol>
    <p>
      403 只有携带 Scope 的显式 <code>insufficient_scope</code> Challenge 才能触发
      Step-up。Scope Upgrade 与 Transport Replay 分别拥有独立硬上限。Issuer 变化会
      强制启动新的 Issuer-bound Registration Flow。
    </p>
  </section>

  <section aria-labelledby="mcp-oauth-user-agent-title">
    <h2 id="mcp-oauth-user-agent-title">由 Host 持有 User-agent 边界</h2>
    <p>
      Native Host 在打开 Browser 前占用 Loopback Listener，只接受配置的
      Address、 Port 与 Path，返回一次完整 Callback URL 后关闭
      Listener。StateKnot 强制 5 分钟 默认 Handoff Timeout、精确 Callback
      Binding、PKCE、State、RFC 8707 Resource Indicator 与 RFC 9207 Issuer
      Check。URL、Code、Verifier、Client Identity 与 Token 绝不能进入 Log。
    </p>
  </section>

  <section aria-labelledby="mcp-oauth-store-title">
    <h2 id="mcp-oauth-store-title">把 Store 当作安全基础设施</h2>
    <ul>
      <li>
        加密保存 Access Token、Refresh Token、Client Secret 与 PKCE
        State，并具备 Key Rotation Procedure。
      </li>
      <li>
        按 Tenant、Principal、MCP Resource 与 Authorization-server Issuer
        隔离记录。
      </li>
      <li>State 必须一次性且会过期；Credential Replacement 必须原子执行。</li>
      <li>
        Discovery、Registration、Refresh、Migration、Scope Upgrade、Cancellation
        与 Failure 只产生脱敏 Audit Fact。
      </li>
    </ul>
  </section>

  <section aria-labelledby="mcp-oauth-proof-title">
    <h2 id="mcp-oauth-proof-title">复现精确声明</h2>
    <div class="docs-code" data-code-block>
      <div class="docs-code-head">
        <span>Shell · 本地 Contract 与冻结官方门禁</span>
        <button
          class="copy-button affordance"
          type="button"
          data-copy-button
          data-copy-target="zh-mcp-oauth-verify-code"
        >
          <span data-copy-label aria-live="polite">复制</span>
        </button>
      </div>
      <pre
        id="zh-mcp-oauth-verify-code"
        tabindex="0"><code>{verifyCode}</code></pre>
    </div>
    <p>
      冻结门禁通过全部 32 个计分 Client 场景，其中包括全部 25 个 OAuth 场景：373
      项计分 Assertion Success、0 Failure。7 个官方明确不计分的 Extension
      单独报告， 不进入支持声明。请阅读<a href="/zh/docs/mcp-conformance/"
        >完整证据边界</a
      >与<a
        href="https://github.com/StateKnot/StateKnot/blob/main/docs/mcp-oauth.zh-CN.md"
        >完整运维合约</a
      >。
    </p>
  </section>
</DocsLayout>
