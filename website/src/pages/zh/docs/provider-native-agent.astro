import DocsLayout from "../../../layouts/DocsLayout.astro";

const compileCode = `let definition = ProviderNativeAgentGraph::compile(
    typed_definition.descriptor().clone(),
    graph_identity,
    reducer_identity,
    state_schema_id,
    input_security_label,
    policy,
    accounting,
)?;

definition.register_schema(&mut schemas)?;
register_standard_agent_cancellation_event_schema(&mut schemas)?;`;

const parallelToolCode = `let execution = AgentExecutionConfig::new(
    AgentStructuredOutputStrategy::ModelNative,
    max_model_turns,
    ExecutionCount::new(1),
    max_tool_calls_per_turn,
    AgentToolConcurrency::parallel_read_only(ExecutionCount::new(8)),
)?;`;
---

<DocsLayout
  title="运行 Provider-native Model/Tool Graph。"
  description="编译一套 Digest-pinned Agent 组合，从耐久证据执行有序、有界并行的 Model/Tool Turn，并在不伪造 Usage 的前提下确认 Cancellation。"
  section="Provider-native Agent"
  locale="zh-CN"
>
  <aside
    class="docs-callout docs-callout--boundary"
    aria-labelledby="provider-native-scope-title"
  >
    <h2 id="provider-native-scope-title">已实现的 pre-alpha 边界</h2>
    <p>
      预置 Graph、本地 Policy 边界、精确 Invocation Accounting、多轮 Transcript
      Assembly、耐久 Cancellation Observation 与 Lifecycle Confirmation
      已实现。Crate 尚未发布；有界 Read-only Tool 并发已经实现，Parallel Write
      保持串行，并且有界耐久 Structured-output Repair 已实现。<a
        href="/zh/docs/agent-service/">AgentService v1</a
      > 已通过嵌入式边界暴露该 Definition，<a href="/zh/docs/mcp-remote-tool/"
        >严格 MCP Remote Tool Profile</a
      > 与 <a href="/zh/docs/a2a-client/">A2A Remote Agent Profile</a> 已提供 Client-side
      Tool Adapter。稳定 Network Transport、更广 Protocol Extension 与生产 验证仍未交付。
    </p>
  </aside>

  <section aria-labelledby="provider-native-example-title">
    <h2 id="provider-native-example-title">编译 Deployment Contract</h2>
    <p>
      从仓库内示例开始。它会构造真实的 Tool-capable Agent、严格 Read-only
      Policy、 显式 Unpriced Accounting、生成 State Schema、标准 Runtime Schema
      与初始 Checkpoint State；不需要 API Key 或数据库，也不会执行任何外部 I/O。
    </p>
    <div class="docs-code" data-code-block>
      <div class="docs-code-head">
        <span>Shell · 确定性、离线</span>
        <button
          class="copy-button affordance"
          type="button"
          data-copy-button
          data-copy-target="provider-native-example-command"
        >
          <span data-copy-label aria-live="polite">复制</span>
        </button>
      </div>
      <pre
        id="provider-native-example-command"
        tabindex="0"><code>cargo run -p stateknot-runtime --example provider_native_agent --locked</code></pre>
    </div>
    <p>
      改造前请先阅读<a
        href="https://github.com/StateKnot/StateKnot/blob/main/crates/stateknot-runtime/examples/provider_native_agent.rs"
        >完整示例源代码</a
      >。示例停在 Deployment Boundary；PostgreSQL Suite 会单独证明 Dispatch 与
      Recovery。
    </p>
  </section>

  <section aria-labelledby="provider-native-freeze-title">
    <h2 id="provider-native-freeze-title">
      同时固定代码、Policy 与 Accounting
    </h2>
    <p>
      Composition Digest 会绑定 Agent、Model、Tool、Instruction、Execution
      Limit、Input Security Label、Policy Implementation 与 Accounting
      Table。任何一项变化都必须发布 新 Graph Version。
    </p>
    <div class="docs-code" data-code-block>
      <div class="docs-code-head">
        <span>Rust · Startup Composition</span>
        <button
          class="copy-button affordance"
          type="button"
          data-copy-button
          data-copy-target="provider-native-compile-code"
        >
          <span data-copy-label aria-live="polite">复制</span>
        </button>
      </div>
      <pre
        id="provider-native-compile-code"
        tabindex="0"><code>{compileCode}</code></pre>
    </div>
    <p>
      Registry 冻结前必须注册全部 Typed Input/Output Schema、Tool
      Schema、Provider Profile 与标准 Runtime Event Schema。任何 Digest
      缺失或冲突都会导致启动失败。存量 Run 始终加载其 Checkpoint 已固定的 Graph
      Version。
    </p>
  </section>

  <section aria-labelledby="provider-native-turn-title">
    <h2 id="provider-native-turn-title">跟随一次耐久 Turn</h2>
    <ol class="evidence-list">
      <li>
        <h3>重建</h3>
        <p>
          Model Node 从不可变 Invocation Ledger 重建 Provider-native Transcript
          Order 与 Cumulative Usage。
        </p>
      </li>
      <li>
        <h3>先提交，再 Dispatch</h3>
        <p>
          Logical Invocation 与 Physical Attempt Start 在 Provider/Tool I/O
          前耐久化。 幂等观察到的 Start 不授予 Dispatch 权限。
        </p>
      </li>
      <li>
        <h3>授权每个 Action</h3>
        <p>
          Canonical Tool Arguments、Proposal Order、Admission 与 Model
          Invocation 共同绑定 Action Digest；Tool Prepare 前必须固定 Policy
          Evidence。
        </p>
      </li>
      <li>
        <h3>依据 Ledger 推进</h3>
        <p>
          精确 Terminal Revision 成为 Node Result。Crash
          后读取已提交证据，而不是重新 Dispatch 外部调用。
        </p>
      </li>
    </ol>
    <p>
      已知 Tool Failure 会保留为有序 Transcript Outcome。Write 的模糊结果保持
      <code>Unknown</code>，绝不会作为普通 Business Call 重复执行。当 Descriptor
      与 Exact Provider 都启用 Reconciliation 时，Runtime 会针对原 Attempt
      执行一次有界 Probe；权威 Evidence 原子提交，<code>Pending</code> 则成为后续
      Lease 下的耐久延迟 Retry。其他 Binding 继续阻塞，等待人工 Reconciliation。
    </p>
  </section>

  <section aria-labelledby="provider-native-repair-title">
    <h2 id="provider-native-repair-title">从耐久证据修复 Structured Output</h2>
    <p>
      将有限的 <code>max_output_repair_turns</code> 配置在总 Model-turn Ceiling 之下。已提交但不符合
      Schema 的 Response，或带精确 Usage、发生在 Response Phase 的 <code
        >response.malformed</code
      > Adapter Failure，会先绑定进 Node Result，再生成不同的 Repair Invocation 与
      Attempt。Crash 后会加载该 Terminal Ledger Fact，绝不会重新 Dispatch 已损坏的
      Attempt。
    </p>
    <p>
      新 Request 保留原始 Input 与可信 Instruction，再附加保留的 Framework
      Instruction <code>stateknot.output_repair</code>。无效 Payload 与 Provider
      Error Text 不进入 Prompt 或 Transcript；已完成 Tool
      的定义与结果会保留在历史上下文中， 同时选择 <code>none</code
      >、调用上限设为 0。启用 Tool 与 Repair 的 Model 必须显式支持该选择。
      Repair 期间的 Tool Proposal 不会到达 Policy 或 Tool I/O。达到上限后以 <code
        >runtime.agent.output_repair_exhausted</code
      >
      失败并保留精确计费 Turn；缺少 Usage 的损坏 Envelope 继续 Fail Closed。
    </p>
  </section>

  <section aria-labelledby="provider-native-parallel-title">
    <h2 id="provider-native-parallel-title">
      并行 Read，让每个 Write 成为 Barrier
    </h2>
    <p>
      <code>parallel_read_only</code> 只把不可变 Descriptor Risk 为 <code
        >ReadOnly</code
      > 的连续 Tool 按配置上限分组。Policy、Arguments、Prepare 与 Physical Start 仍按
      Provider Proposal 顺序串行；只有 Provider I/O 会重叠。Terminal Evidence 会先缓冲，
      再按相同顺序提交，因此完成时序无法重排 Journal 或下一轮 Model Transcript。
    </p>
    <p>
      每个 Write 必须等前面的 Read 全部落盘后单独执行，后面的 Read 也必须等待其
      Terminal Fact。Cancellation 会 Abort Child Provider Task，不会将其
      Detach；已提交 Start 仍由 Fenced Recovery 观察。并发值必须依据真实
      Provider Quota 与 Connection Capacity 设置。
    </p>
    <div class="docs-code" data-code-block>
      <div class="docs-code-head">
        <span>Rust · 有界 Read-only Tool I/O</span>
        <button
          class="copy-button affordance"
          type="button"
          data-copy-button
          data-copy-target="zh-provider-native-parallel-code"
          data-copy-idle="复制"
          data-copy-loading="复制中"
          data-copy-success="已复制"
          data-copy-error="复制失败"
        >
          <span data-copy-label aria-live="polite">复制</span>
        </button>
      </div>
      <pre
        id="zh-provider-native-parallel-code"
        tabindex="0"><code>{parallelToolCode}</code></pre>
    </div>
  </section>

  <section aria-labelledby="provider-native-cancel-title">
    <h2 id="provider-native-cancel-title">把 Cancellation 视为两条耐久事实</h2>
    <dl class="docs-definition-list">
      <div>
        <dt>Request</dt>
        <dd>
          已认证 Control Plane Append 不可变 Cancellation Intent。Driver
          轮询耐久状态、 停止新 Dispatch、发出 Cooperative
          Cancellation，并执行有界 Grace Period。
        </dd>
      </div>
      <div>
        <dt>Confirm</dt>
        <dd>
          Agent Loop 把精确 Checkpoint、Journal Head、Revision、Failure ID 与
          Lease 交给 Lifecycle；后者重建 Usage，并使用数据库时间原子确认
          Cancellation。
        </dd>
      </div>
      <div>
        <dt>Fail closed</dt>
        <dd>
          Executing Model、Unknown Write 或缺失 Model Usage 会让 Run 保持
          <code>cancellation_requested</code>。StateKnot 不会用零 Usage
          替代不可用 Evidence。
        </dd>
      </div>
    </dl>
    <p>
      可公开的 Confirmation Schema 位于<a
        href="/schemas/runtime/agent-cancellation-event/1.0.0"
        >稳定 Runtime Identity</a
      >。<a href="/zh/docs/agent-service/">AgentService v1</a> 现在提供 Authorization-first
      Cancellation Ingress；当前 pre-alpha 的 HTTP/gRPC Transport 仍由嵌入服务负责。
    </p>
  </section>

  <section aria-labelledby="provider-native-proof-title">
    <h2 id="provider-native-proof-title">运行 PostgreSQL 证据</h2>
    <p>
      按照 <a href="/zh/docs/postgresql/">PostgreSQL 指南</a
      >配置测试数据库后，强制运行 Integration
      Suite，不允许因基础设施缺失而跳过。
    </p>
    <div class="docs-code" data-code-block>
      <div class="docs-code-head">
        <span>Shell · PostgreSQL 16 或 17</span>
        <button
          class="copy-button affordance"
          type="button"
          data-copy-button
          data-copy-target="provider-native-test-command"
        >
          <span data-copy-label aria-live="polite">复制</span>
        </button>
      </div>
      <pre
        id="provider-native-test-command"
        tabindex="0"><code>STATEKNOT_REQUIRE_POSTGRES_TESTS=1 \
cargo test -p stateknot-runtime --test postgres provider_native --locked</code></pre>
    </div>
    <p>
      Focused Case 在两个受支持 PostgreSQL Major 上覆盖：多轮 Recovery 不重复
      Model Dispatch、Stale-fence Policy Race、已知失败 Tool、一次 Business Call
      的 Unknown → Pending → Committed Reconciliation、有界 Read-only Overlap
      与有序 Write Barrier、跨新 Lease 的已提交/Adapter-failed Output
      Repair、精确 Repair Exhaustion、Repair-time Tool Rejection、精确 Usage
      Cancellation、 Pre-dispatch Cancellation，以及 Evidence-unavailable 的
      Fail-closed 行为。
    </p>
  </section>

  <section aria-labelledby="provider-native-boundary-title">
    <h2 id="provider-native-boundary-title">保持 Release Boundary 可见</h2>
    <ul>
      <li>
        已实现串行与有界 Parallel Read-only Tool；所有 Write
        有意保持串行。显式可信 Executor Contract 下的 Journal-isolated Graph
        Sibling Ordering 也已实现。
      </li>
      <li>
        已实现 Model-native Structured Output 与有界耐久 Repair；
        Tool-call-emulated Final Output 会被拒绝。
      </li>
      <li>
        已实现精确 Cancellation Confirmation 与 AgentService v1 嵌入式 Ingress；
        尚未实现稳定 HTTP/gRPC Transport。
      </li>
      <li>
        已实现 Provider-native Execution Core、严格 MCP Remote Tool 与 A2A
        Remote Agent Binding。独立 MCP/A2A Server Profile 已存在，但尚未组合进本
        Graph； 更广 Protocol Extension、A2A Live-peer Reconciliation
        Qualification、通用 Artifact Lifecycle/Public Delivery、Failover 与生产
        Release 仍未交付。
      </li>
    </ul>
    <p>
      完整 Integration 与 Operations Contract 见<a
        href="https://github.com/StateKnot/StateKnot/blob/main/docs/provider-native-agent.zh-CN.md"
        >仓库指南</a
      >。
    </p>
  </section>
</DocsLayout>
