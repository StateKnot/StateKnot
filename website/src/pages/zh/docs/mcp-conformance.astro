import DocsLayout from "../../../layouts/DocsLayout.astro";

const reproduceCommand = `cd conformance/mcp-client
npm ci --ignore-scripts
cd ../..
bash conformance/mcp-client/run-2026-07-28.sh`;

const scenarios = [
  ["tools_call", 2, 0],
  ["request-metadata", 5, 3],
  ["http-standard-headers", 3, 8],
  ["http-custom-headers", 18, 0],
  ["http-invalid-tool-headers", 11, 0],
  ["json-schema-ref-no-deref", 1, 0],
  ["sep-2322-client-request-state", 5, 0],
] as const;
---

<DocsLayout
  title="MCP Conformance 声明以证据为界。"
  description="查看固定官方 Runner、全部 7 个非 OAuth Client 场景、可复现 CI 门禁，以及 StateKnot 不声明的 OAuth/Server 边界。"
  section="MCP Conformance 状态"
  locale="zh-CN"
>
  <aside
    class="docs-callout docs-callout--boundary"
    aria-labelledby="mcp-conformance-boundary-title"
  >
    <h2 id="mcp-conformance-boundary-title">当前声明</h2>
    <p>
      通用 Stateless Tool Client 通过冻结 MCP 2026-07-28 Requirement Set 中全部
      7 个计分非 OAuth Client 场景。剩余 25 个计分 OAuth 场景尚未实现，因此
      StateKnot 不声明完整 Client、Server、Authorization Server 或 SDK-tier
      Conformance。
    </p>
  </aside>

  <section aria-labelledby="mcp-conformance-input-title">
    <h2 id="mcp-conformance-input-title">冻结的评估输入</h2>
    <dl class="docs-definition-list">
      <div>
        <dt>Runner</dt>
        <dd><code>@modelcontextprotocol/conformance@0.2.0-alpha.11</code></dd>
      </div>
      <div>
        <dt>Integrity</dt>
        <dd>
          <code
            >sha512-imPK9tx5gQsL6ZKQq4MrsyDYfSaIwpRmX6+ogjbeAXs9LGvxkBxWcY7KcS7TvwaBk/ZiVWl6b/naF4q83UwDRA==</code
          >
        </dd>
      </div>
      <div>
        <dt>Source Identity</dt>
        <dd><code>c321dd32035556e6769d3724a8ee97d87c3faaac</code></dd>
      </div>
      <div>
        <dt>Requirement Revision</dt>
        <dd><code>2026-07-28</code></dd>
      </div>
      <div>
        <dt>场景清单</dt>
        <dd>
          69 个计分场景：37 个 Server、7 个非 OAuth Client、25 个 OAuth Client。
        </dd>
      </div>
      <div>
        <dt>Expected Failure</dt>
        <dd>无。</dd>
      </div>
    </dl>
  </section>

  <section aria-labelledby="mcp-conformance-result-title">
    <h2 id="mcp-conformance-result-title">Observed Result</h2>
    <div
      class="docs-table-wrap"
      tabindex="0"
      aria-label="官方 MCP Client 场景结果"
    >
      <table>
        <thead>
          <tr
            ><th>官方 Client 场景</th><th>Success</th><th>Skipped</th><th
              >Failure</th
            ></tr
          >
        </thead>
        <tbody>
          {
            scenarios.map(([name, success, skipped]) => (
              <tr>
                <td>
                  <code>{name}</code>
                </td>
                <td>{success}</td>
                <td>{skipped}</td>
                <td>0</td>
              </tr>
            ))
          }
          <tr><th>合计</th><th>45</th><th>11</th><th>0</th></tr>
        </tbody>
      </table>
    </div>
    <p>
      3 个 Metadata Skip 是 StateKnot 没有声明的 Optional Roots、Sampling 与
      Elicitation。8 个 Standard Header Skip 属于本 Tool Client 外的 Lifecycle、
      Resource 与 Prompt Method。Skip 不计作 Pass，也不会授予能力声明。
    </p>
  </section>

  <section aria-labelledby="mcp-conformance-proof-title">
    <h2 id="mcp-conformance-proof-title">复现强制门禁</h2>
    <div class="docs-code" data-code-block>
      <div class="docs-code-head">
        <span>Shell · 固定官方 Runner</span>
        <button
          class="copy-button affordance"
          type="button"
          data-copy-button
          data-copy-target="zh-mcp-conformance-run-code"
        >
          <span data-copy-label aria-live="polite">复制</span>
        </button>
      </div>
      <pre
        id="zh-mcp-conformance-run-code"
        tabindex="0"><code>{reproduceCommand}</code></pre>
    </div>
    <p>
      脚本构建真实 Rust Driver、逐个运行场景、保存官方原始
      Output，并在场景缺失、 重复、意外增加、失败或 Count Drift 时失败。CI 固定
      Rust 1.88.0 与 Node.js 24.19.0，不使用 Expected-failures File
      执行同一命令。
    </p>
  </section>

  <section aria-labelledby="mcp-conformance-surfaces-title">
    <h2 id="mcp-conformance-surfaces-title">两个 Tool Surface，两种保证</h2>
    <p>
      <a href="/zh/docs/mcp-client/"><code>McpClient</code></a> 接受官方 Fixture 使用的广泛合法
      Tool 形态。<a href="/zh/docs/mcp-remote-tool/"
        ><code>McpRemoteTool</code></a
      > 继续强制更严格合约：已审核 Input/Output Schema、固定 Server Identity、 已校验
      Structured Output、Durable-before-dispatch State，以及 Ambiguous Write 后的显式
      Reconciliation。通用 Fixture 通过不会削弱该耐久合约。
    </p>
  </section>

  <section aria-labelledby="mcp-conformance-next-title">
    <h2 id="mcp-conformance-next-title">剩余发布门禁</h2>
    <p>
      完整 Client Conformance 需要经过独立安全评审的 OAuth 实现，并通过全部 25
      个冻结 OAuth 场景。MCP Server、Resources、Prompts、Tasks 与 SDK-tier 声明
      分别需要自己的实现和官方证据。阅读<a
        href="https://github.com/StateKnot/StateKnot/blob/main/docs/mcp-conformance.zh-CN.md"
        >完整证据报告</a
      >与<a href="https://github.com/modelcontextprotocol/conformance"
        >官方 Runner 源码</a
      >。
    </p>
  </section>
</DocsLayout>
