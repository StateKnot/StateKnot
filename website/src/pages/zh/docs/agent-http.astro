import DocsLayout from "../../../layouts/DocsLayout.astro";
const code = `use std::sync::Arc;
use stateknot::agent_http::{AgentHttpOptions, AgentHttpService};

// service：已绑定精确部署版本与资源授权策略的 AgentServiceV1。
// verifier：接入真实身份系统的 AgentHttpAuthenticator，不能使用测试凭据。
let options = AgentHttpOptions::new(["agents.example.com".to_owned()])?;
let http = AgentHttpService::new(service, Arc::new(verifier), options);
let router = http.router();
// 在 TLS 入口后挂载；单独运行 Worker；由宿主启动和排空监听器。`;
---

<DocsLayout
  title="通过认证 HTTP 提交与恢复 Agent。"
  description="在持久化 Agent 服务之上提供四个有界 JSON 操作，覆盖可信身份、精确重试与两阶段取消。"
  section="Agent HTTP v1"
  locale="zh-CN"
>
  <aside
    class="docs-callout docs-callout--boundary"
    aria-labelledby="http-boundary"
  >
    <h2 id="http-boundary">JSON 接入已实现，尚非稳定版</h2>
    <p>
      <code>AgentHttpService</code> 在 <a href="/zh/docs/agent-service/"
        >AgentService v1</a
      > 之上提供真实 HTTP 路由。它把任务持久化入库，不会在请求处理期间执行模型、工具或
      Graph。StateKnot 仍处于 pre-alpha；活动 SSE 现已支持显式启用，完整托管服务与稳定版验收仍需后续开发。
    </p>
  </aside>
  <section aria-labelledby="http-wiring">
    <h2 id="http-wiring">接入可信身份与资源授权</h2>
    <p>
      必须配置 <code>AgentHttpAuthenticator</code
      >，验证签名或令牌内省证据、签发方、受众、有效期与吊销状态，再映射可信租户、主体，以及彼此独立的
      <code>Submit</code>、<code>Read</code>、<code>Cancel</code> 权限。框架没有默认放行器，也没有匿名模式。
    </p>
    <p>
      底层 <code>AgentServiceAuthorizer</code> 仍在查询资源前，检查精确 Agent/请求、Run
      或提交键摘要的访问权限。请求 JSON、未验证的 JWT 和任意转发头不能决定身份。客户端预算只能收窄宿主策略。
    </p>
    <div class="docs-code" data-code-block>
      <div class="docs-code-head">
        <span>Rust · 宿主接入</span><button
          class="copy-button affordance"
          type="button"
          data-copy-button
          data-copy-target="http-code"
          ><span data-copy-label aria-live="polite">复制</span></button
        >
      </div>
      <pre id="http-code" tabindex="0"><code>{code}</code></pre>
    </div>
  </section>
  <section aria-labelledby="http-identity">
    <h2 id="http-identity">接入真实身份服务：在线令牌验证</h2>
    <p>
      <code>AgentHttpIntrospection</code> 可直接接入 OAuth 2.0 令牌内省端点， 使用固定
      HTTPS 地址，严格核对签发方、受众、主体、有效期和操作 Scope。 已通过真实 Keycloak
      26.7.3 TLS、密钥轮换和身份撤销测试；没有跳转、环境代理、 自动重试、令牌缓存或不安全
      TLS 开关。这不等于 JWT/JWKS 本地验签或完整 OIDC。
    </p>
    <p>
      <code>TenantPolicy</code> 只接受可信控制面提供的精确主体与租户绑定， 权限取令牌
      Scope 与本地授权的交集。策略最多 1024 项，租期必须显式指定且不超过一小时； 使用带预期代数的
      <code>replace</code> 原子更新，过期后拒绝放行。 租户绑定不是 Run 所有权，原有
      <code>AgentServiceAuthorizer</code> 仍须逐资源授权。
    </p>
    <p>
      用 <code>replace_client_secret</code> 安装密钥管理服务下发的新凭据。 就绪检查通过真实客户端认证发送随机无效令牌，要求返回
      inactive； 它只验证端点和凭据可用，不能替代业务授权或资源策略就绪检查。 没有凭据重叠窗口的轮换会短暂返回
      503，不能降级放行。
    </p>
    <p>
      默认整次验证最多 3 秒、32 个并发请求、64 KiB 响应； 每次 HTTP 请求和 SSE
      授权循环都在线验证，需规划身份服务容量。
      已进入网络缓冲的字节无法撤回。测试身份服务和测试账号不会部署到官网。
    </p>
    <p>
      <a
        href="https://github.com/StateKnot/StateKnot/blob/main/docs/agent-identity.zh-CN.md"
        >完整接线、轮换与故障恢复指南</a
      >
      · <a
        href="https://github.com/StateKnot/StateKnot/blob/main/docs/rfcs/0011-agent-http-introspection.md"
        >RFC-0011（Draft）</a
      >
    </p>
  </section>
  <section aria-labelledby="http-worker">
    <h2 id="http-worker">单独运行执行角色</h2>
    <p>
      现在可使用独立的<a href="/zh/docs/agent-loop/#owned-worker"
        >持久执行 Worker</a
      >， 管理具体租户或公平调度器、真实依赖就绪检查、固定并发和停机回收。 HTTP
      接入仍独立运行，提交 Run 不会自动启动 Worker 或维护任务。
    </p>
    <p>
      通过独立的<a href="/zh/docs/agent-loop/#owned-maintenance">维护角色</a
      >驱动 截止时间取消、子 Run 结算、Join 发布与失败收敛；即使没有可执行的
      Run，维护仍应运行。
    </p>
  </section>

  <section aria-labelledby="agent-host">
    <h2 id="agent-host">统一管理同进程的三个角色</h2>
    <p>
      <code>AgentHostBindings::new</code> 接管实际接入、Worker 和维护绑定；
      <code>AgentHostDependencies</code> 强制提供真实身份、资源策略和执行依赖检查。
      <code>AgentHost::launch</code> 独占认领共享接入，在异步启动之前返回拥有所有权的句柄；
      取消 <code>host.wait_ready().await</code> 不会丢失所有权。 应用仍须验证三者的数据库、注册表与租户范围兼容。
    </p>
    <p>
      启动顺序为“维护 → Worker → HTTP”。已有持久化任务可在启动期间执行，
      后续启动失败会回收已启动角色，但不回滚已提交工作。 每个 HTTP
      请求都会检查实际兄弟角色的新鲜就绪状态，维护不可用时 Worker
      暂停接纳新工作。 已接纳任务仍可能完成；不要另外挂载输入服务的克隆 Router
      绕过统一入口门禁。
    </p>
    <p>
      <code>host.health()</code> 是不含业务载荷的内部视图，不是匿名运维接口。 任一角色意外退出都会关闭入口并排空其他角色。
      <code>host.shutdown().await</code> 按“HTTP → Worker → 维护”完成回收， 保留 Worker
      清理期间的维护能力。Drop 只能发起停止，不能同步等待回收。 操作系统停机预算必须覆盖三个角色的期限之和与任务销毁时间；进程停止不等于持久化用户取消。
    </p>
    <p>
      PostgreSQL 16/17 与真实 TLS Keycloak
      验证组合恢复、依赖门禁、启动失败、角色退出及任务回收。
      受保护运维接口与实测部署、容量 SLO 仍需后续完成。
      官网仅部署静态文档，不部署使用测试身份的 Agent 运行服务。
      <a
        href="https://github.com/StateKnot/StateKnot/blob/main/docs/agent-host.zh-CN.md"
        >接线与恢复指南</a
      >
      · <a
        href="https://github.com/StateKnot/StateKnot/blob/main/docs/rfcs/0015-owned-agent-host.md"
        >RFC-0015（Draft）</a
      >
    </p>
  </section>

  <section aria-labelledby="http-resource-policy">
    <h2 id="http-resource-policy">配置真实资源授权：精确权限与可恢复提交</h2>
    <p>
      <code>runtime::agent_policy::AgentResourcePolicy</code> 提供离线、默认拒绝的资源授权。
      提交规则精确匹配租户、签发方与主体、Agent 版本和输入 Schema，并附带 Scope 与预算限制。
      Run 读取、取消以及提交键查找分别授权；知道 Run ID 不代表拥有权限。
      <code>TenantRuns</code> 是明确授予的租户运维权限，不是自动所有权判断。
    </p>
    <p>
      使用 <code>PolicyDocument</code> 构造 <code>PolicyArtifact</code
      >，激活前私下保留规范化文件与可信摘要。 总计最多 1024 条规则、256 KiB
      JSON；重复或重叠选择器直接拒绝。 冻结注册表前调用 <code
        >register_agent_policy_evidence_schema</code
      >， 再把共享策略传给 <code>AgentServiceV1</code
      >，并将资源策略就绪与身份服务就绪组合检查。
    </p>
    <p>
      策略绝对到期时间跨重启保留，本地新鲜度租期最多一小时；<code>replace</code> 通过预期代数原子更新。
      过期返回 503，无授权规则返回 403；撤销后 SSE 在后续授权检查中关闭。 Admission
      保留命中规则、请求摘要与预算证据；更新其他资源的权限不会破坏原键重试。 若修改实际命中的提交规则而返回
      409，应在当前授权下按键找回，不自动换键重复提交。
    </p>
    <p>
      读取与拒绝决策不自动写入持久审计账本，取消只保留策略与决策摘要；宿主须按要求保留受保护的审计上下文。
      已接入真实 PostgreSQL 16/17 与 Keycloak
      验证；不包含自动所有权存储，也不代表完整生产版本。
      <a
        href="https://github.com/StateKnot/StateKnot/blob/main/docs/agent-resource-policy.zh-CN.md"
        >配置、接线与运维指南</a
      >
      · <a
        href="https://github.com/StateKnot/StateKnot/blob/main/docs/rfcs/0012-agent-resource-policy.md"
        >RFC-0012（Draft）</a
      >
    </p>
  </section>
  <section aria-labelledby="http-operations">
    <h2 id="http-operations">四个操作，共用持久化服务</h2>
    <dl class="docs-definition-list">
      <div>
        <dt>POST /v1/agent-runs</dt><dd>
          序列化 <code>AgentHttpSubmission</code>：submission_key、含版本的完整
          agent 身份，以及绑定 Schema 的 request。201 表示新建；200 表示找回原
          Run。
        </dd>
      </div>
      <div>
        <dt>GET /v1/agent-runs/&#123;run_id&#125;</dt><dd>
          不带请求体。200
          返回通过完整性校验的公开快照，不包含私有检查点和对话记录。
        </dd>
      </div>
      <div>
        <dt>POST /v1/agent-runs/lookup</dt><dd>
          序列化带 submission_key 的 <code>AgentHttpLookup</code>。提交键不进入
          URL，也不要记录到访问日志。
        </dd>
      </div>
      <div>
        <dt>POST /v1/agent-runs/&#123;run_id&#125;/cancellation</dt><dd>
          序列化已保存的 <code>AgentCancellationIds</code>，包含 event_id 与
          failure_id。202 表示请求已记录；200 表示找回同一对身份对应的请求。
        </dd>
      </div>
    </dl>
    <p>
      请求使用 Bearer 凭据，POST 使用 JSON。Accept 只能省略、设为 <code
        >application/json</code
      > 或 <code>*/*</code>。Rust 类型可生成 JSON
      Schema；未知字段、嵌套重复键、查询参数及非规范路径均会被拒绝。
    </p>
    <p>
      成功响应为 <code
        >AgentHttpRunResponse &#123; request_id, snapshot &#125;</code
      >。request_id 只关联本次响应，不是幂等键。<code>Active</code> 不代表 Worker
      此刻正在执行，也可能处于失败收尾阶段；<code>CancellationRequested</code> 不代表取消清理已经完成。
    </p>
  </section>
  <section aria-labelledby="http-sse">
    <h2 id="http-sse">断线后按活动游标继续读取</h2>
    <p>
      在同一个认证宿主上启用 <code
        >with_sse(AgentHttpSseOptions::default())</code
      >， 使用 Bearer 凭据和 <code>Accept: text/event-stream</code> 连接
      <code>GET /v1/agent-runs/&#123;run_id&#125;/events</code>。
      重连时携带最后完整处理并保存的 <code>Last-Event-ID</code>。 原生
      EventSource 不能设置这个认证头，应使用支持认证的流式 HTTP 客户端，
      不能把凭据放进 URL 或改成匿名访问。
    </p>
    <dl class="docs-definition-list">
      <div>
        <dt>activity</dt><dd>
          每条保留日志对应一个公开通知。id 是经数据库核对的 续传游标，JSON
          只有十进制字符串序号与记录时间，不暴露私有载荷、日志种类或对话。
        </dd>
      </div>
      <div>
        <dt>snapshot</dt><dd>
          当前经过验证的 AgentHttpRunResponse，不带 id。
          它不是游标位置上的历史状态，中间快照可能合并；仅隔离状态变化也会通知。
        </dd>
      </div>
      <div>
        <dt>error / heartbeat</dt><dd>
          都不推进续传进度。错误帧只尽力发送，
          心跳是注释；连接结束不能证明任务执行成功。
        </dd>
      </div>
    </dl>
    <p>
      先幂等处理活动，再保存完整游标。更换进程后仍从该精确事件之后续传。
      畸形编码返回 400；被篡改、跨范围或历史不可用的游标返回
      <code>agent_http.invalid_cursor</code>（409），不能悄悄重置进度。 这不是
      Token 流、完整历史状态重放，也不承诺 exactly-once 交付。
    </p>
    <p>
      默认最多 16 个流生产任务、60 秒连接时限、1 秒轮询/心跳、5 秒队列等待、
      单槽有界缓冲及每条连接累计 64 MiB 输出。事件流与 JSON 请求使用独立额度。
      每轮重新验证凭据与资源权限；已授权并交给网络缓冲区的字节无法撤回。
      丢弃响应、队列超时和停机都会停止生产任务。宿主还须限制 Socket
      并关闭该路由的代理缓冲和压缩。
    </p>
    <p>
      <a
        href="https://github.com/StateKnot/StateKnot/blob/main/docs/agent-events.zh-CN.md"
        >完整客户端恢复与生产部署指南</a
      >
      · <a
        href="https://github.com/StateKnot/StateKnot/blob/main/docs/rfcs/0009-agent-sse-replay.md"
        >RFC-0009</a
      >
    </p>
  </section>
  <section aria-labelledby="http-server">
    <h2 id="http-server">管理就绪状态、连接与优雅停机</h2>
    <p>
      <code>AgentHttpServer::start</code> 接管只绑定本机回环地址的 HTTP/1 监听器，由同一网络命名空间内的代理负责公网
      TLS。启动前校验实际使用的 PostgreSQL Schema、精确可执行注册表，并强制提供 <code
        >AgentHttpReadiness</code
      >，
      检查请求真正使用的凭据验证与资源策略依赖。不会默认安装身份验证器，也不自动执行迁移、启动
      Worker 或调度器。
    </p>
    <p>
      默认每次检查完成后间隔 10 秒再检查，整个检查限时 5 秒，就绪证据有效期为 20
      秒。 检查不重叠；依赖失败、超时或证据过期时，新业务请求返回
      503，后续检查成功才重新接入。
      就绪不等于获得授权，也不保证下一次请求一定成功；已接入的请求仍受原有授权和时限控制。
    </p>
    <p>
      传输层默认最多 256 个连接、64 个请求头、32 KiB 解析缓冲、5
      秒请求头读取时限和 300
      秒连接绝对存活时限。超额连接直接关闭，不进入业务处理。JSON 与 SSE
      各自的上限继续生效；TLS、代理限制及跨副本配额仍需部署方配置。
    </p>
    <p>
      <code>server.health()</code> 只提供本地状态和活动连接数，应接入受保护的管理或进程监督界面；
      不会在 Agent API 中添加匿名健康检查入口。依赖不可用时可以仍然存活，但不接收新业务。
    </p>
    <p>
      <code>server.begin_shutdown()</code> 立即撤销就绪状态；等待 <code
        >server.shutdown()</code
      >
      停止接收连接并允许已接入工作完成。默认排空 30 秒后，取消并回收剩余连接任务；SSE
      可能需要这一强制关闭阶段。检查停机报告，并保留原提交键、取消身份及游标：连接关闭不代表事务回滚。
      直接丢弃服务句柄会中止工作，但不等于已经等待优雅停机。阻塞式回调仍需进程监督器的外层强制退出期限；
      共享数据库连接池由部署方管理，不会被服务擅自关闭。
    </p>
    <p>
      PostgreSQL 16/17
      实测覆盖就绪失效与恢复、启动失败、排空期间成功提交、慢请求体和 SSE
      强制关闭、空闲连接及句柄释放、传输上限。真实身份与策略服务的角色集成和稳定版发布仍是后续门禁。
      <a
        href="https://github.com/StateKnot/StateKnot/blob/main/docs/agent-http-server.md"
        >完整接线与运维指南</a
      >
      · <a
        href="https://github.com/StateKnot/StateKnot/blob/main/docs/rfcs/0010-owned-agent-http-server.md"
        >RFC-0010</a
      >
    </p>
  </section>
  <section aria-labelledby="http-retry">
    <h2 id="http-retry">响应丢失后找回任务，不重复创建</h2>
    <p>
      首次提交前，持久保存高熵提交键及完整逻辑请求；首次取消前，保存两个取消
      ID。超时、断连、服务停机或响应超限，都不等于数据库事务已回滚。
    </p>
    <p>
      通过原提交键或 Run
      查询，或保留原内容和身份进行有界退避重试。相同键却更改提交内容，或者另换一对取消
      ID，会返回
      409。先核对持久化状态，不要因为没收到响应就生成新键。重试得到的快照可能已推进到更新版本。
    </p>
  </section>
  <section aria-labelledby="http-limits">
    <h2 id="http-limits">资源上限与不泄露载荷的错误</h2>
    <p>
      默认请求上限 256 KiB、响应上限 2 MiB、每个共享服务实例最多 64
      个并发请求、协作式总超时 15 秒。硬上限分别为 2 MiB、8 MiB、1,024 个请求及
      60 秒；JSON 还有结构深度等限制。异步超时不能抢占宿主中的阻塞代码。
    </p>
    <p>
      400 表示格式错误；401/403 表示认证或策略拒绝；404
      只在授权后表示目标不存在；405/406/415 表示不支持的 HTTP 形式；409
      表示冲突；413 表示请求体超限或读取失败；429 表示容量已满；503
      表示依赖不可用、超时或停机；500 表示完整性、配置或响应上限问题。
    </p>
    <p>
      JSON 操作均返回禁止缓存的私有 JSON，带关联 ID 和 API
      版本头。错误只返回固定的 <code>agent_http.*</code> 代码与 request_id，不转发令牌、SQL
      或提供商原始消息。429 与 503 附带 <code>Retry-After: 1</code>。
    </p>
  </section>
  <section aria-labelledby="http-operations-checklist">
    <h2 id="http-operations-checklist">对外上线前的配置清单</h2>
    <ol>
      <li>
        固定兼容的源码、锁文件、数据库迁移、Graph 和 Schema。独立配置调度器与
        Worker；仅提交任务不会推动 Run 执行。
      </li>
      <li>
        配置 TLS、精确 Host
        白名单、连接数及请求头上限、租户配额与跨副本流量控制。转发头不能扩大信任。默认拒绝
        Origin；可选精确 HTTPS 来源不意味着开放 CORS。
      </li>
      <li>
        接入真实凭据验证与精确资源策略，验证过期、吊销、错误受众及跨租户访问。不可部署测试中的静态凭据。
      </li>
      <li>
        日志不记录认证头、提交键、输入输出和原始路径；监控有界延迟/错误指标及依赖就绪状态。
      </li>
      <li>
        使用运行角色时等待 <code>server.shutdown()</code
        >。仅嵌入路由的部署仍需调用
        <code>http.shutdown()</code> 并自行限制连接排空时间。替换服务后，用原身份恢复可能已经提交的请求。
      </li>
    </ol>
    <p>
      验证覆盖真实 HTTP + PostgreSQL 16/17、24
      路同键并发提交、提交/取消响应丢失恢复、无内联执行、恶意输入、数据库不可用前的授权拒绝、慢请求、过载与停机。
      SSE 另外覆盖新进程续传、撤权、仅隔离状态变化及完全不读取响应的情况。
      这不等于已完成真实身份提供商、模型或整套生产部署的验收。
    </p>
