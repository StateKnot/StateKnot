{
  "name": "@stateknot/website",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11.0.0 <12"
  },
  "scripts": {
    "build": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro build",
    "check": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro check",
    "dev": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "npm run build",
    "preview": "cross-env ASTRO_TELEMETRY_DISABLED=1 ASTRO_PREVIEW_BACKGROUND=0 astro preview",
    "test": "playwright test",
    "test:e2e": "playwright test",
    "verify": "npm run format:check && npm run check && npm run test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "astro": "7.2.10"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "cross-env": "10.1.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "6.0.3"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-astro"
    ],
    "overrides": [
      {
        "files": "*.astro",
        "options": {
          "parser": "astro"
        }
      }
    ]
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
