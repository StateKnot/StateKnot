+async fn backend_gone(db: &PgPool, pid: i32) {
+    tokio::time::timeout(Duration::from_secs(10), async {
+        loop {
+            let gone: bool = query_scalar("SELECT NOT EXISTS (SELECT 1 FROM pg_stat_activity WHERE pid=$1)")
+                .bind(pid).fetch_one(db).await.unwrap();
+            if gone { return; }
+            tokio::time::sleep(Duration::from_millis(25)).await;
+        }
+    }).await.expect("killed Wait writer backend did not disappear");
+}
+
+async fn resolve_all(store: &PostgresStore, db: &PgPool, scenario: &Scenario) {
+    let before = snapshot(db, scenario).await;
+    let request = store.load_interrupt_request(scenario.fence.tenant_id(), scenario.fence.run_id(), scenario.interrupts[0]).await.unwrap();
+    // The public constructor refuses unauthorized authority before a Store call;
+    // never fabricate an intent to pretend this is a database authorization cut.
+    assert!(matches!(InterruptResolutionIntent::new(
+        &request, EventId::generate(), test_payload(), InterruptResolver::new(principal("other"), scopes()),
+    ), Err(DurableWaitError::ResolverPrincipalMismatch)));
+    assert!(matches!(InterruptResolutionIntent::new(
+        &request, EventId::generate(), test_payload(), InterruptResolver::new(principal("resumer"), ScopeSet::default()),
+    ), Err(DurableWaitError::ResolverScopesInsufficient)));
+    assert_eq!(snapshot(db, scenario).await, before);
+    for (index,id) in scenario.interrupts.into_iter().enumerate() {
+        let run = store.load_run(scenario.fence.tenant_id(), scenario.fence.run_id()).await.unwrap();
+        let request = store.load_interrupt_request(scenario.fence.tenant_id(), scenario.fence.run_id(), id).await.unwrap();
+        let event = EventId::generate();
+        let intent = InterruptResolutionIntent::new(&request,event,test_payload(),InterruptResolver::new(principal("resumer"),scopes())).unwrap();
+        let payload = JournalPayload::new(test_payload().schema().clone(),
+            JournalEventKind::new("nested-wait-resolved").unwrap(),
+            BoundedJson::try_from_value(json!({"interrupt_id":id.to_string()})).unwrap()).unwrap();
+        let append = JournalAppend::new(JournalExpectation::exact(run.journal_head().unwrap().clone()),
+            JournalEventIntent::control_plane(scenario.fence.tenant_id().clone(),scenario.fence.run_id(),event,payload).unwrap()).unwrap();
+        let actual = store.resolve_interrupt(append.clone(),run.lifecycle().revision(),intent.clone()).await.unwrap();
+        let retry = store.resolve_interrupt(append,run.lifecycle().revision(),intent).await.unwrap();
+        assert_eq!(actual.record(),retry.record());
+        let next = store.load_run(scenario.fence.tenant_id(), scenario.fence.run_id()).await.unwrap();
+        assert_eq!(next.unresolved_wait_count(),1-u8::try_from(index).unwrap());
+        assert!(next.lease().is_none());
+        assert_eq!(next.lifecycle().status(),if index==0 { RunStatus::Waiting } else { RunStatus::Active });
+        if index==0 {
+            assert!(matches!(store.claim_lease(scenario.fence.tenant_id(),scenario.fence.run_id(),AttemptId::generate()).await,
+                Err(StoreError::RunNotRunnable)));
+        }
+    }
+}
