+#[allow(clippy::too_many_lines)]
+async fn run_cut(store: &PostgresStore, db: &PgPool, connection: &PgConnectOptions, cut: Cut) {
+    let scenario = Box::pin(prepare(store)).await;
+    let before = snapshot(db,&scenario).await;
+    let mut proxy = CommitProxy::start(connection,cut,TransactionTarget::GraphFrameBarrier).await;
+    let mut interrupted = TestProcess::spawn(WORKER,&json!({"role":"cut","scenario":scenario,"proxy_port":proxy.port()}));
+    proxy.wait_cut(cut).await;
+    let backend = proxy.backend_pid();
+    let at_cut = snapshot(db,&scenario).await;
+    let committed = cut==Cut::CommitResponse;
+    let original = if committed {
+        assert_atomic_wait(&before,&at_cut);
+        let record = owning_wait(store,&scenario).await;
+        assert_eq!(record.event().event_id(),scenario.event);
+        assert_eq!(record.event().source().worker_fence(),Some(&scenario.fence));
+        Some((record.digest(),immutable_wait(&at_cut,&record)))
+    } else {
+        assert_eq!(at_cut,before,"unforwarded Wait COMMIT leaked facts");
+        None
+    };
+    interrupted.kill_and_reap().await;
+    proxy.stop().await;
+    backend_gone(db,backend).await;
+    assert_eq!(snapshot(db,&scenario).await,at_cut);
+    let replacement = if committed { None } else {
+        let lease = store.supersede_lease(scenario.fence.tenant_id(),scenario.fence.run_id(),AttemptId::generate()).await.unwrap();
+        assert!(lease.lease().fence().epoch()>scenario.fence.epoch());
+        let stable = snapshot(db,&scenario).await;
+        assert!(matches!(Box::pin(attempt(store,&fixture(scenario.interrupts),&scenario)).await,Err(StoreError::StaleFence)));
+        assert_eq!(snapshot(db,&scenario).await,stable,"fresh old-fence Wait wrote facts");
+        Some(lease.lease().fence().clone())
+    };
+    let before_recovery = snapshot(db,&scenario).await;
+    let mut recovery = TestProcess::spawn(WORKER,&json!({"role":"resume","scenario":scenario,"committed":committed,"replacement":replacement}));
+    let ready = recovery.ready().await.unwrap();
+    assert_eq!(ready["phase"],"waiting_before_authorized_resolution");
+    assert_eq!(ready["original_ack"],committed);
+    if let Some((digest,_)) = &original {
+        assert_eq!(ready["digest"],json!(digest));
+        assert_eq!(snapshot(db,&scenario).await,before_recovery,"old ACK created facts");
+    }
+    let record = owning_wait(store,&scenario).await;
+    assert_eq!(ready["digest"],json!(record.digest()));
+    let waiting_rows = snapshot(db,&scenario).await;
+    let bundle = immutable_wait(&waiting_rows,&record);
+    Box::pin(resolve_all(store,db,&scenario)).await;
+    recovery.resume();
+    recovery.wait_success().await;
+    let final_rows = snapshot(db,&scenario).await;
+    assert_eq!(immutable_wait(&final_rows,&record),bundle);
+    assert!(before["pending_node_results"].as_array().unwrap().iter().all(|row|final_rows["pending_node_results"].as_array().unwrap().contains(row)));
+    assert_eq!(final_rows["interrupt_resolutions"].as_array().unwrap().len(),2);
+    if let Some((digest,original)) = original {
+        assert_eq!(record.digest(),digest);
+        assert_eq!(bundle,original);
+    }
+    let final_record = store.load_graph_frame_barrier(
+        scenario.fence.tenant_id(), scenario.fence.run_id(), scenario.base.frame().namespace(),
+        scenario.base.checkpoint().checkpoint_id(),
+    ).await.unwrap().unwrap();
+    assert_eq!(final_record.digest(),record.digest());
+    if committed {
+        // Only this branch has a real committed request with every original
+        // parameter retained. The Before branch uses a genuine new Driver plan.
+        let GraphFrameBarrierCommitOutcome::Idempotent(replayed) =
+            Box::pin(attempt(store,&fixture(scenario.interrupts),&scenario)).await.unwrap()
+        else { panic!("original Wait ACK after Return must remain idempotent"); };
