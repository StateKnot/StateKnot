{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stknot.com/schemas/runtime/agent-admission-event/1.0.0",
  "title": "StateKnot Agent admission event data",
  "description": "Public-safe correlation metadata for one atomic Agent admission. Request data, authorization evidence, principals, instructions, and policy payloads are deliberately excluded.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation",
    "intent_digest",
    "graph_digest",
    "policy_digest",
    "input_digest"
  ],
  "properties": {
    "operation": {
      "const": "agent_admitted"
    },
    "intent_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "graph_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "input_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
