  "artifact_input_document": {
    "$defs": {
      "ArtifactModality": {
        "description": "Semantic modality used for provider capability negotiation and rendering.\n\nThe declared modality is not inferred from, and cannot override, the media\ntype or byte-level inspection policy. Adapters must validate all three when\nmapping an artifact to an external provider or protocol.",
        "oneOf": [
          {
            "const": "text",
            "description": "Large or externally stored textual content.",
            "type": "string"
          },
          {
            "const": "image",
            "description": "Image content.",
            "type": "string"
          },
          {
            "const": "audio",
            "description": "Audio content.",
            "type": "string"
          },
          {
            "const": "video",
            "description": "Video content.",
            "type": "string"
          },
          {
            "const": "document",
            "description": "Human-oriented document content.",
            "type": "string"
          },
          {
            "const": "structured_data",
            "description": "Machine-oriented structured data.",
            "type": "string"
          },
          {
            "const": "archive",
            "description": "An archive or compound package.",
            "type": "string"
          },
          {
            "const": "binary",
            "description": "Other opaque binary content.",
            "type": "string"
          }
        ]
      },
      "SchemaReference": {
        "additionalProperties": false,
        "description": "An immutable reference to canonical JSON schema bytes.\n\nThe explicit version supports compatibility policy, while the digest\nprevents a reused URI or version from silently changing validation\nbehavior.",
        "properties": {
          "digest": {
            "maxLength": 71,
            "minLength": 71,
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "id": {
            "format": "uri",
            "maxLength": 512,
            "minLength": 9,
            "pattern": "^https://[^?#]+$",
            "type": "string"
          },
          "version": {
            "maxLength": 62,
            "minLength": 5,
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
            "type": "string"
          }
        },
        "required": [
          "id",
          "version",
          "digest"
        ],
        "type": "object"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "Integrity and interpretation metadata for immutable artifact bytes.",
    "properties": {
      "byte_length": {
        "maxLength": 20,
        "minLength": 1,
        "pattern": "^(0|[1-9][0-9]{0,19})$",
        "type": "string"
      },
      "digest": {
        "maxLength": 71,
        "minLength": 71,
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "media_type": {
        "description": "A canonical concrete media type. StateKnot additionally enforces RFC name syntax, unique sorted parameters, parameter count/value bounds, and canonical quoting at runtime.",
        "maxLength": 512,
        "minLength": 3,
        "pattern": "^[a-z0-9][a-z0-9!#$&.^_+-]{0,126}/[a-z0-9][a-z0-9!#$&.^_+-]{0,126}(?:;.*)?$",
        "type": "string"
      },
      "modality": {
        "$ref": "#/$defs/ArtifactModality"
      },
      "schema": {
        "anyOf": [
          {
            "$ref": "#/$defs/SchemaReference"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "media_type",
      "modality",
      "byte_length",
      "digest"
    ],
    "title": "ArtifactRepresentation",
    "type": "object"
  }
}
